@{
    ViewData["Title"] = "Inicio";
    var nombreUsuario = User.Identity?.Name ?? "Usuario";
    var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="text-center mb-4" data-aos="fade-down">
            <h1 class="display-6">
                <i class="ti ti-calculator"></i> Bienvenido, @nombreUsuario
            </h1>
            <p class="text-muted">
                Rol: <span class="badge bg-azure-lt text-azure">@rolUsuario</span>
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-6" data-aos="fade-up" data-aos-delay="0">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <i class="ti ti-users display-4 text-azure"></i>
                        <h5 class="card-title mt-3">Mis Clientes</h5>
                        <p class="card-text text-muted">Gestioná tu cartera de clientes: crear, editar y consultar.</p>
                        <a asp-controller="Clientes" asp-action="Index" class="btn btn-azure">
                            <i class="ti ti-arrow-right"></i> Ir a Clientes
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6" data-aos="fade-up" data-aos-delay="80">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <i class="ti ti-notebook display-4 text-muted"></i>
                        <h5 class="card-title mt-3">Próximamente</h5>
                        <p class="card-text text-muted">Asientos contables, reportes, importaciones y más.</p>
                        <button class="btn btn-outline-azure" disabled>
                            <i class="ti ti-clock"></i> En desarrollo
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@model ProyectoIntegrador.UI.Models.CuentaContableViewModel
@{
    ViewData["Title"] = "Detalle de cuenta contable";
    var estadoClase = Model.Estado == "Activa" ? "bg-green-lt text-green" : "bg-red-lt text-red";
    var imputableClase = Model.EsImputable ? "bg-green-lt text-green" : "bg-yellow-lt text-yellow";
    var sistemaClase = Model.EsSistema ? "bg-azure-lt text-azure" : "bg-muted-lt text-muted";
    var clienteId = ViewData["ClienteId"] is Guid cid ? cid : Guid.Empty;
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">Cuenta contable</h2>
                <div class="text-secondary">Detalle de la cuenta seleccionada</div>
            </div>
            <div class="col-auto ms-auto">
                <a asp-controller="Clientes" asp-action="PlanDeCuentas" asp-route-id="@clienteId" class="btn btn-outline-azure">
                    <i class="ti ti-arrow-left"></i> Volver al plan
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge @estadoClase">@Model.Estado</span>
                    <span class="badge @imputableClase">@(Model.EsImputable ? "Imputable" : "No imputable")</span>
                    <span class="badge @sistemaClase">@(Model.EsSistema ? "Sistema" : "Usuario")</span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Código</label>
                        <input class="form-control sg-readonly" value="@Model.Codigo" readonly />
                    </div>
                    <div class="col-md-8 mb-3">
                        <label class="form-label">Nombre</label>
                        <input class="form-control sg-readonly" value="@Model.Nombre" readonly />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tipo</label>
                        <input class="form-control sg-readonly" value="@Model.Tipo" readonly />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Naturaleza</label>
                        <input class="form-control sg-readonly" value="@Model.Naturaleza" readonly />
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-clienteId="@clienteId" class="btn btn-azure">
                        <i class="ti ti-edit"></i> Editar
                    </a>
                    @if (Model.Estado == "Activa")
                    {
                        <a asp-action="CreateSubcuenta" asp-route-parentId="@Model.Id" class="btn btn-outline-azure">
                            <i class="ti ti-plus"></i> Agregar subcuenta
                        </a>
                    }

                    @if (!Model.EsSistema)
                    {
                        if (Model.Estado == "Activa")
                        {
                            <form asp-action="Desactivar" asp-route-id="@Model.Id" asp-route-planId="@Model.PlanCuentasId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger">
                                    <i class="ti ti-circle-x"></i> Desactivar
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Activar" asp-route-id="@Model.Id" asp-route-planId="@Model.PlanCuentasId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-success">
                                    <i class="ti ti-circle-check"></i> Activar
                                </button>
                            </form>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

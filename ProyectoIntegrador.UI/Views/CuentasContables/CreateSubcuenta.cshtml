@model ProyectoIntegrador.UI.Models.CuentaContableFormViewModel
@{
    ViewData["Title"] = "Crear subcuenta";
    var cuentaPadre = Model.CuentaPadre;
    var clienteId = ViewData["ClienteId"] as Guid? ?? Guid.Empty;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="card-title mb-4">
                    <i class="ti ti-plus"></i> Crear subcuenta
                </h3>

                @if (cuentaPadre is not null)
                {
                    <div class="alert alert-info">
                        <strong>Cuenta padre:</strong> @cuentaPadre.Codigo - @cuentaPadre.Nombre
                    </div>
                }
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                }

                <form asp-action="CreateSubcuenta" asp-route-clienteId="@clienteId" method="post">
                    <input type="hidden" asp-for="Cuenta.PlanCuentasId" />
                    <input type="hidden" asp-for="Cuenta.CuentaPadreId" />
                    <input type="hidden" name="clienteId" value="@clienteId" />

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Cuenta.Codigo" class="form-label"></label>
                            <input asp-for="Cuenta.Codigo" class="form-control" />
                            <span asp-validation-for="Cuenta.Codigo" class="text-danger"></span>
                        </div>
                        <div class="col-md-8 mb-3">
                            <label asp-for="Cuenta.Nombre" class="form-label"></label>
                            <input asp-for="Cuenta.Nombre" class="form-control" />
                            <span asp-validation-for="Cuenta.Nombre" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Cuenta.Tipo" class="form-label"></label>
                            <input asp-for="Cuenta.Tipo" class="form-control" readonly />
                            <div class="form-hint">Se hereda de la cuenta padre.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Cuenta.Naturaleza" class="form-label"></label>
                            <input asp-for="Cuenta.Naturaleza" class="form-control" readonly />
                            <div class="form-hint">Se hereda de la cuenta padre.</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="form-check">
                                <input asp-for="Cuenta.EsImputable" class="form-check-input" />
                                <label asp-for="Cuenta.EsImputable" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Cuenta.Estado" class="form-label"></label>
                            <input asp-for="Cuenta.Estado" class="form-control sg-readonly" readonly />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn sg-btn-primary-dark">
                            <i class="ti ti-check"></i> Crear subcuenta
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Cuenta.CuentaPadreId" asp-route-planId="@Model.Cuenta.PlanCuentasId" asp-route-clienteId="@clienteId" class="btn btn-outline-secondary">
                            <i class="ti ti-x"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            var alertDiv = $('.alert-danger');
            alertDiv.each(function () {
                if ($(this).text().trim().length > 0) {
                    $(this).show();
                }
            });
        });
    </script>
}

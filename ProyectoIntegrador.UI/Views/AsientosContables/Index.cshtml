@model LibroDiarioIndexViewModel
@{
    ViewData["Title"] = "Libro Diario";
    ViewData["ClienteId"] = Model.ClienteId;
    ViewData["ClienteNombre"] = Model.ClienteNombre;
}

@section Scripts {
    <script>
        (function () {
            var table = document.getElementById('asientos-table');
            if (!table) return;

            var tbody = table.querySelector('tbody');
            var headers = table.querySelectorAll('.table-sort');

            function getCellValue(row, key) {
                switch (key) {
                    case 'numero':
                        return parseInt(row.querySelector('td[data-value]')?.dataset.value || '0', 10);
                    case 'ejercicio':
                        return row.children[1].dataset.value || '';
                    case 'fecha':
                        return row.children[2].dataset.value || '';
                    case 'glosa':
                        return (row.children[3].dataset.value || '').toLowerCase();
                    case 'debe':
                        return parseFloat(row.children[4].dataset.value || '0');
                    case 'haber':
                        return parseFloat(row.children[5].dataset.value || '0');
                    case 'estado':
                        return row.children[6].querySelector('[data-value]')?.dataset.value || '';
                    default:
                        return '';
                }
            }

            function comparar(a, b, key, direction) {
                var factor = direction === 'desc' ? -1 : 1;
                if (key === 'estado') {
                    var rank = { 'Confirmado': 0, 'Revertido': 1 };
                    var aState = rank[getCellValue(a, 'estado')] ?? 99;
                    var bState = rank[getCellValue(b, 'estado')] ?? 99;
                    if (aState !== bState) return (aState - bState) * factor;

                    var aEj = getCellValue(a, 'ejercicio');
                    var bEj = getCellValue(b, 'ejercicio');
                    if (aEj !== bEj) return aEj.localeCompare(bEj) * factor;

                    var aNum = getCellValue(a, 'numero');
                    var bNum = getCellValue(b, 'numero');
                    return (aNum - bNum) * factor;
                }

                var aVal = getCellValue(a, key);
                var bVal = getCellValue(b, key);

                if (typeof aVal === 'number' && typeof bVal === 'number') {
                    return (aVal - bVal) * factor;
                }

                return aVal.toString().localeCompare(bVal.toString()) * factor;
            }

            headers.forEach(function (header) {
                header.addEventListener('click', function () {
                    var key = header.dataset.key;
                    var current = header.dataset.order || 'none';
                    var direction = current === 'asc' ? 'desc' : 'asc';

                    headers.forEach(function (h) {
                        h.dataset.order = '';
                        h.classList.remove('text-azure');
                    });

                    header.dataset.order = direction;
                    header.classList.add('text-azure');

                    var rows = Array.from(tbody.querySelectorAll('tr'));
                    rows.sort(function (a, b) {
                        return comparar(a, b, key, direction);
                    });

                    rows.forEach(function (row) {
                        tbody.appendChild(row);
                    });
                });
            });
        })();
    </script>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-1"><i class="ti ti-book"></i> Libro Diario</h2>
        @if (!string.IsNullOrWhiteSpace(Model.ClienteNombre))
        {
            <div class="text-secondary">@Model.ClienteNombre</div>
        }
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Importacion" asp-action="Iniciar" asp-route-clienteId="@Model.ClienteId" class="btn btn-outline-secondary">
            <i class="ti ti-file-import"></i> Importar asientos
        </a>
        <a asp-action="Crear" asp-route-clienteId="@Model.ClienteId" class="btn btn-azure">
            <i class="ti ti-plus"></i> Nuevo asiento
        </a>
        <a asp-controller="Clientes" asp-action="Detalles" asp-route-id="@Model.ClienteId" class="btn btn-outline-azure">
            <i class="ti ti-arrow-left"></i> Volver
        </a>
    </div>
</div>

<div class="card mb-3" data-aos="fade-up">
    <div class="card-header">
        <h3 class="card-title"><i class="ti ti-filter me-1"></i> Filtros</h3>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index" asp-route-clienteId="@Model.ClienteId" class="row g-3 align-items-end">
            <input type="hidden" name="clienteId" value="@Model.ClienteId" />
            <div class="col-md-4">
                <label class="form-label">Ejercicio</label>
                <select name="ejercicioId" class="form-select">
                    <option value="">Todos los ejercicios</option>
                    @foreach (var ej in Model.Ejercicios)
                    {
                        <option value="@ej.Id" selected="@(Model.EjercicioId == ej.Id)">
                            @ej.FechaInicio.Year – @ej.FechaFin.Year (@ej.Estado)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Fecha desde</label>
                <input type="date" name="fechaDesde" class="form-control"
                       value="@(Model.FechaDesde.HasValue ? Model.FechaDesde.Value.ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Fecha hasta</label>
                <input type="date" name="fechaHasta" class="form-control"
                       value="@(Model.FechaHasta.HasValue ? Model.FechaHasta.Value.ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-azure flex-fill">
                    <i class="ti ti-search"></i> Filtrar
                </button>
                <a asp-action="Index" asp-route-clienteId="@Model.ClienteId" class="btn btn-outline-secondary">
                    <i class="ti ti-x"></i>
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.Items.Count == 0)
{
    <div class="card">
        <div class="card-body">
            <div class="empty">
                <div class="empty-img">
                    <i class="ti ti-book-off fs-1 text-secondary"></i>
                </div>
                <p class="empty-title">No hay asientos registrados</p>
            </div>
        </div>
    </div>
}
else
{
    <div class="card" data-aos="fade-up" data-aos-delay="60">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0" id="asientos-table">
                    <thead class="table-light">
                        <tr>
                            <th style="width:80px">
                                <button type="button" class="btn btn-link p-0 text-reset text-decoration-none table-sort" data-key="numero">
                                    N° <i class="ti ti-selector ms-1"></i>
                                </button>
                            </th>
                            <th style="width:140px">
                                <button type="button" class="btn btn-link p-0 text-reset text-decoration-none table-sort" data-key="ejercicio">
                                    Ejercicio <i class="ti ti-selector ms-1"></i>
                                </button>
                            </th>
                            <th style="width:110px">
                                <button type="button" class="btn btn-link p-0 text-reset text-decoration-none table-sort" data-key="fecha">
                                    Fecha <i class="ti ti-selector ms-1"></i>
                                </button>
                            </th>
                            <th>
                                <button type="button" class="btn btn-link p-0 text-reset text-decoration-none table-sort" data-key="glosa">
                                    Glosa <i class="ti ti-selector ms-1"></i>
                                </button>
                            </th>
                            <th class="text-end">
                                <button type="button" class="btn btn-link p-0 text-reset text-decoration-none table-sort" data-key="debe">
                                    Debe <i class="ti ti-selector ms-1"></i>
                                </button>
                            </th>
                            <th class="text-end">
                                <button type="button" class="btn btn-link p-0 text-reset text-decoration-none table-sort" data-key="haber">
                                    Haber <i class="ti ti-selector ms-1"></i>
                                </button>
                            </th>
                            <th style="width:110px">
                                <button type="button" class="btn btn-link p-0 text-reset text-decoration-none table-sort" data-key="estado">
                                    Estado <i class="ti ti-selector ms-1"></i>
                                </button>
                            </th>
                            <th class="text-end" style="width:100px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var asiento in Model.Items)
                        {
                            var ejercicio = Model.Ejercicios.FirstOrDefault(e => e.Id == asiento.EjercicioId);
                            var ejercicioOrden = ejercicio is null
                                ? string.Empty
                                : $"{ejercicio.FechaInicio:yyyyMMdd}-{ejercicio.FechaFin:yyyyMMdd}";
                            <tr>
                                <td class="fw-semibold text-secondary" data-value="@asiento.Numero">@asiento.Numero</td>
                                <td data-value="@ejercicioOrden">
                                    @if (ejercicio is not null)
                                    {
                                        <span class="text-secondary">
                                            @ejercicio.FechaInicio.Year–@ejercicio.FechaFin.Year
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td data-value="@asiento.Fecha.ToString("yyyyMMdd")">@asiento.Fecha.ToString("dd/MM/yyyy")</td>
                                <td data-value="@asiento.Glosa">@asiento.Glosa</td>
                                <td class="text-end" data-value="@asiento.TotalDebe.ToString(System.Globalization.CultureInfo.InvariantCulture)">@asiento.TotalDebe.ToString("N2")</td>
                                <td class="text-end" data-value="@asiento.TotalHaber.ToString(System.Globalization.CultureInfo.InvariantCulture)">@asiento.TotalHaber.ToString("N2")</td>
                                <td>
                                    @if (asiento.Estado == "Confirmado")
                                    {
                                        <span class="badge bg-success-lt text-success" data-value="Confirmado">Confirmado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-red-lt text-danger" data-value="Revertido">Revertido</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Detalles" asp-route-id="@asiento.Id"
                                       asp-route-clienteId="@Model.ClienteId"
                                       class="btn btn-sm btn-ghost-azure">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <div class="card-footer d-flex align-items-center justify-content-between">
                <div class="text-secondary">
                    Mostrando @((Model.Pagina - 1) * Model.CantidadPorPagina + 1)–@Math.Min(Model.Pagina * Model.CantidadPorPagina, Model.Total)
                    de @Model.Total asientos
                </div>
                <ul class="pagination m-0">
                    <li class="page-item @(Model.Pagina == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-clienteId="@Model.ClienteId"
                           asp-route-ejercicioId="@Model.EjercicioId"
                           asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
                           asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))"
                           asp-route-pagina="@(Model.Pagina - 1)">
                            <i class="ti ti-chevron-left"></i>
                        </a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPaginas; p++)
                    {
                        <li class="page-item @(p == Model.Pagina ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-clienteId="@Model.ClienteId"
                               asp-route-ejercicioId="@Model.EjercicioId"
                               asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
                               asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))"
                               asp-route-pagina="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Pagina == Model.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-clienteId="@Model.ClienteId"
                           asp-route-ejercicioId="@Model.EjercicioId"
                           asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
                           asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))"
                           asp-route-pagina="@(Model.Pagina + 1)">
                            <i class="ti ti-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </div>
        }
    </div>
}
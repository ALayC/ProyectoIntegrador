@model CrearAsientoViewModel
@{
    ViewData["Title"] = "Registrar Asiento Contable";
}

@section Scripts {
<script>
(function () {
    const cuentasData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Cuentas.Select(c => new { id = c.Id, texto = $"{c.Codigo} – {c.Nombre}" })
    ));

    // ── Estado global de cotización ─────────────────────────────────────
    let tcUsdObtenido = false;   // true una vez que BCU respondió (exitoso o fallback)
    let tcUsdBuscando = false;   // true mientras el fetch está en curso
    let tcUsdValor    = null;    // valor numérico obtenido del BCU (null si aún no hay)

    // ── Función auxiliar para parsear decimales con coma o punto ───────
    function parsearDecimal(valor) {
        if (typeof valor === 'number') return valor;
        if (!valor) return 0;
        // Normalizar: reemplazar coma por punto para parseFloat
        const valorNormalizado = String(valor).replace(',', '.');
        const resultado = parseFloat(valorNormalizado);
        return isNaN(resultado) ? 0 : resultado;
    }

    // ── Banner de aviso ─────────────────────────────────────────────────
    function mostrarBannerEspera() {
        setBanner('warning', '<span class="spinner-border spinner-border-sm me-2"></span>Obteniendo cotización USD del BCU...');
        document.getElementById('btn-submit').disabled = true;
    }

    function mostrarBannerFallback(fechaReal) {
        setBanner('warning',
            `<i class="ti ti-alert-triangle me-1"></i>BCU no tiene cotización para la fecha del asiento. ` +
            `Se usó el valor del <strong>${fechaReal}</strong>. Verificá el T/C antes de guardar.`);
        document.getElementById('btn-submit').disabled = false;
    }

    function mostrarBannerError() {
        setBanner('danger',
            '<i class="ti ti-wifi-off me-1"></i>No se pudo obtener la cotización del BCU. ' +
            'Ingresá el tipo de cambio manualmente en cada línea USD.');
        document.getElementById('btn-submit').disabled = false;
    }

    function ocultarBanner() {
        const b = document.getElementById('banner-cotizacion');
        if (b) b.remove();
        document.getElementById('btn-submit').disabled = false;
    }

    function setBanner(tipo, html) {
        let b = document.getElementById('banner-cotizacion');
        if (!b) {
            b = document.createElement('div');
            b.id = 'banner-cotizacion';
            // Insertar justo antes de la card de líneas
            const cardLineas = document.getElementById('card-lineas');
            cardLineas.parentNode.insertBefore(b, cardLineas);
        }
        b.className = `alert alert-${tipo} py-2 px-3 mb-2`;
        b.innerHTML = html;
    }

    // ── Consulta al proxy de UI ─────────────────────────────────────────
    async function obtenerCotizacionUsd() {
        if (tcUsdBuscando) return;
        tcUsdBuscando = true;
        mostrarBannerEspera();

        const fechaInput = document.getElementById('Fecha')?.value ?? '';

        try {
            const url = `/AsientosContables/CotizacionUsd?fecha=${encodeURIComponent(fechaInput)}`;
            const resp = await fetch(url, { credentials: 'same-origin' });
            const data = await resp.json();

            if (!data.ok) {
                mostrarBannerError();
                return;
            }

            // Rellenar T/C en todas las líneas USD que el usuario NO tocó (valor == 1)
            document.querySelectorAll('.linea-fila').forEach(fila => {
                const selMoneda = fila.querySelector('[name$=".Moneda"]');
                const inputTc   = fila.querySelector('[name$=".TipoCambio"]');
                if (!selMoneda || !inputTc) return;
                if (selMoneda.value !== 'USD') return;
                // Solo pisar si el usuario no editó (valor sigue siendo el default 1)
                if (parsearDecimal(inputTc.value) === 1) {
                    // Asegurar que el valor se asigne con formato numérico estándar (punto decimal)
                    inputTc.value = Number(data.valor).toFixed(6);
                    inputTc.classList.add('border-warning');
                }
            });

            actualizarTotales();

            if (data.esFallback) {
                mostrarBannerFallback(data.fechaReal);
            } else {
                ocultarBanner();
            }

            tcUsdValor    = data.valor;
            tcUsdObtenido = true;
        } catch {
            mostrarBannerError();
        } finally {
            tcUsdBuscando = false;
        }
    }

    // ── Detectar primera vez que alguna línea cambia a USD ──────────────
    function alCambiarMoneda(selectEl) {
        actualizarTotales();
        if (selectEl.value === 'USD') {
            if (!tcUsdObtenido) {
                // Primera vez: lanzar fetch al BCU
                obtenerCotizacionUsd();
            } else if (tcUsdValor !== null) {
                // Ya tenemos el TC: aplicarlo a esta línea si el usuario no lo tocó
                const fila = selectEl.closest('.linea-fila');
                const inputTc = fila?.querySelector('[name$=".TipoCambio"]');
                if (inputTc && parsearDecimal(inputTc.value) === 1) {
                    inputTc.value = Number(tcUsdValor).toFixed(6);
                    inputTc.classList.add('border-warning');
                    actualizarTotales();
                }
            }
        }
        // Si vuelve a UYU → restaurar TC a 1 si sigue siendo el valor de BCU
        if (selectEl.value === 'UYU') {
            const fila = selectEl.closest('.linea-fila');
            const inputTc = fila?.querySelector('[name$=".TipoCambio"]');
            if (inputTc && parsearDecimal(inputTc.value) !== 1) {
                // Solo resetear si no quedó ninguna otra línea en USD
                const hayOtrasUsd = [...document.querySelectorAll('.linea-fila')]
                    .some(f => f !== fila && f.querySelector('[name$=".Moneda"]')?.value === 'USD');
                if (!hayOtrasUsd) tcUsdObtenido = false;
            }
            if (inputTc) { inputTc.value = '1'; inputTc.classList.remove('border-warning'); }
            actualizarTotales();
            // Ocultar banner si no queda ninguna línea USD
            const hayUsd = [...document.querySelectorAll('[name$=".Moneda"]')].some(s => s.value === 'USD');
            if (!hayUsd) ocultarBanner();
        }
    }

    function buildSelect(name, index) {
        const sel = document.createElement('select');
        sel.className = 'form-select form-select-sm';
        sel.name = `Lineas[${index}].CuentaContableId`;
        sel.required = true;
        const placeholder = new Option('— Seleccione cuenta —', '', true, true);
        placeholder.disabled = true;
        sel.appendChild(placeholder);
        cuentasData.forEach(c => {
            sel.appendChild(new Option(c.texto, c.id));
        });
        return sel;
    }

    function actualizarTotales() {
        let debe = 0, haber = 0;
        document.querySelectorAll('.linea-fila').forEach(fila => {
            const tc = parsearDecimal(fila.querySelector('[name$=".TipoCambio"]')?.value) || 1;
            debe  += (parsearDecimal(fila.querySelector('[data-campo="debe"]').value)  || 0) * tc;
            haber += (parsearDecimal(fila.querySelector('[data-campo="haber"]').value) || 0) * tc;
        });
        document.getElementById('total-debe').textContent  = debe.toFixed(2);
        document.getElementById('total-haber').textContent = haber.toFixed(2);

        const badge = document.getElementById('balance-badge');
        if (Math.abs(debe - haber) < 0.001) {
            badge.className = 'badge bg-success ms-2';
            badge.textContent = 'Balanceado ✓';
        } else {
            badge.className = 'badge bg-danger ms-2';
            badge.textContent = `Diferencia: ${(debe - haber).toFixed(2)}`;
        }
    }

    function agregarLinea() {
        const tbody = document.getElementById('lineas-body');
        const index = tbody.querySelectorAll('.linea-fila').length;

        const tr = document.createElement('tr');
        tr.className = 'linea-fila';
        tr.innerHTML = `
            <td></td>
            <td><input type="number" class="form-control form-control-sm" name="Lineas[${index}].Debe"
                 min="0" step="0.01" value="0" data-campo="debe" /></td>
            <td><input type="number" class="form-control form-control-sm" name="Lineas[${index}].Haber"
                 min="0" step="0.01" value="0" data-campo="haber" /></td>
            <td>
                <select class="form-select form-select-sm" name="Lineas[${index}].Moneda">
                    <option value="UYU" selected>UYU</option>
                    <option value="USD">USD</option>
                </select>
            </td>
            <td><input type="text" class="form-control form-control-sm" name="Lineas[${index}].TipoCambio"
                 inputmode="decimal" pattern="[0-9]*\.?[0-9]+" value="1" /></td>
            <td class="text-center">
                <button type="button" class="btn btn-ghost-danger btn-sm btn-eliminar-linea">
                    <i class="ti ti-trash"></i>
                </button>
            </td>`;

        const tdSelect = tr.querySelector('td:first-child');
        tdSelect.appendChild(buildSelect('', index));

        tbody.appendChild(tr);

        tr.querySelectorAll('input[type=number]').forEach(i => {
            i.addEventListener('input', actualizarTotales);
            i.addEventListener('focus', manejarFocusImporte);
            i.addEventListener('blur', manejarBlurImporte);
        });
        tr.querySelectorAll('[name$=".Moneda"]').forEach(s => s.addEventListener('change', () => alCambiarMoneda(s)));

        // Si ya tenemos el TC y se agrega una nueva línea, auto-rellenar si BCU ya respondió ok
        if (tcUsdObtenido) {
            // nada — el usuario elige la moneda y el campo queda en 1 hasta que elija USD
        }
        actualizarTotales();
    }

    function manejarFocusImporte(e) {
        const value = e.target.value.trim();
        if (value === '0' || value === '0.00') e.target.value = '';
    }

    function manejarBlurImporte(e) {
        if (e.target.value.trim() === '') e.target.value = '0';
        actualizarTotales();
    }

    document.getElementById('btn-agregar-linea').addEventListener('click', agregarLinea);

    document.getElementById('lineas-body').addEventListener('click', function (e) {
        const btn = e.target.closest('.btn-eliminar-linea');
        if (!btn) return;
        const filas = document.querySelectorAll('.linea-fila');
        if (filas.length <= 2) return;
        btn.closest('tr').remove();
        document.querySelectorAll('.linea-fila').forEach((fila, i) => {
            fila.querySelectorAll('[name]').forEach(el => {
                el.name = el.name.replace(/Lineas\[\d+\]/, `Lineas[${i}]`);
            });
        });
        actualizarTotales();
        // Si ya no hay líneas USD, resetear estado
        const hayUsd = [...document.querySelectorAll('[name$=".Moneda"]')].some(s => s.value === 'USD');
        if (!hayUsd) { tcUsdObtenido = false; ocultarBanner(); }
    });

    document.querySelectorAll('.linea-fila input[type=number]').forEach(i => {
        i.addEventListener('input', actualizarTotales);
        i.addEventListener('focus', manejarFocusImporte);
        i.addEventListener('blur', manejarBlurImporte);
    });
    document.querySelectorAll('.linea-fila [name$=".Moneda"]').forEach(s =>
        s.addEventListener('change', () => alCambiarMoneda(s)));

    // ── Normalizar valores antes de enviar el formulario ────────────────────
    document.querySelector('form')?.addEventListener('submit', function(e) {
        // Normalizar todos los inputs de TipoCambio: reemplazar coma por punto
        document.querySelectorAll('[name$=".TipoCambio"]').forEach(input => {
            if (input.value) {
                const valorNormalizado = input.value.replace(',', '.');
                input.value = valorNormalizado;
                console.log('TipoCambio normalizado:', valorNormalizado);
            }
        });
    });

    actualizarTotales();
})();
</script>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="ti ti-notebook"></i> Registrar Asiento Contable</h2>
    <a asp-action="Index" asp-route-clienteId="@Model.ClienteId" class="btn btn-ghost-secondary">
        <i class="ti ti-arrow-left"></i> Volver al Libro Diario
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-attention">
        <i class="ti ti-alert-circle"></i>
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<style>
    .alert-attention {
        animation: alertPulse 0.7s ease-in-out;
    }

    @@keyframes alertPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(214, 57, 57, 0.35);
        }
        100% {
            box-shadow: 0 0 0 12px rgba(214, 57, 57, 0);
        }
    }
</style>

<form asp-action="Crear" asp-route-clienteId="@Model.ClienteId" method="post">
    @Html.AntiForgeryToken()

    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title"><i class="ti ti-info-circle"></i> Datos del asiento</h3>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Cliente</label>
                    <input class="form-control" value="@Model.ClienteNombre" disabled />
                </div>
                <div class="col-md-4">
                    <label asp-for="EjercicioId" class="form-label">Ejercicio contable <span class="text-danger">*</span></label>
                    <select asp-for="EjercicioId" class="form-select">
                        <option value="">— Seleccione ejercicio —</option>
                        @foreach (var ej in Model.Ejercicios)
                        {
                            <option value="@ej.Id">@ej.FechaInicio.Year – @ej.FechaFin.Year (@ej.Estado)</option>
                        }
                    </select>
                    <span asp-validation-for="EjercicioId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Fecha" class="form-label">Fecha <span class="text-danger">*</span></label>
                    <input asp-for="Fecha" type="date" class="form-control" />
                    <span asp-validation-for="Fecha" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Glosa" class="form-label">Glosa / Descripción <span class="text-danger">*</span></label>
                    <input asp-for="Glosa" class="form-control" placeholder="Descripción del asiento..." />
                    <span asp-validation-for="Glosa" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3" id="card-lineas">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0">
                <i class="ti ti-list"></i> Líneas del asiento
                <span id="balance-badge" class="badge bg-danger ms-2">Diferencia: 0.00</span>
            </h3>
            <button type="button" id="btn-agregar-linea" class="btn btn-sm btn-azure">
                <i class="ti ti-plus"></i> Agregar línea
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width:260px">Cuenta contable</th>
                            <th style="min-width:130px">Debe</th>
                            <th style="min-width:130px">Haber</th>
                            <th style="min-width:90px">Moneda</th>
                            <th style="min-width:100px">T/C</th>
                            <th class="text-center" style="width:50px"></th>
                        </tr>
                    </thead>
                    <tbody id="lineas-body">
                        @for (int i = 0; i < Model.Lineas.Count; i++)
                        {
                            <tr class="linea-fila">
                                <td>
                                    <select name="Lineas[@i].CuentaContableId" class="form-select form-select-sm" required>
                                        <option value="">— Seleccione cuenta —</option>
                                        @foreach (var c in Model.Cuentas)
                                        {
                                            <option value="@c.Id" selected="@(Model.Lineas[i].CuentaContableId == c.Id)">@c.Codigo – @c.Nombre</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" name="Lineas[@i].Debe" class="form-control form-control-sm"
                                           min="0" step="0.01" value="@Model.Lineas[i].Debe.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" data-campo="debe" />
                                </td>
                                <td>
                                    <input type="number" name="Lineas[@i].Haber" class="form-control form-control-sm"
                                           min="0" step="0.01" value="@Model.Lineas[i].Haber.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" data-campo="haber" />
                                </td>
                                <td>
                                    <select name="Lineas[@i].Moneda" class="form-select form-select-sm">
                                        <option value="UYU" selected="@(Model.Lineas[i].Moneda == "UYU")">UYU</option>
                                        <option value="USD" selected="@(Model.Lineas[i].Moneda == "USD")">USD</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="text" name="Lineas[@i].TipoCambio" class="form-control form-control-sm"
                                           inputmode="decimal" pattern="[0-9]*\.?[0-9]+" 
                                           value="@Model.Lineas[i].TipoCambio.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)" />
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-ghost-danger btn-sm btn-eliminar-linea"
                                            title="Eliminar línea">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td class="text-end pe-2">Totales</td>
                            <td><span id="total-debe">0.00</span></td>
                            <td><span id="total-haber">0.00</span></td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 justify-content-end">
        <a asp-action="Index" asp-route-clienteId="@Model.ClienteId" class="btn btn-ghost-secondary">
            Cancelar
        </a>
        <button type="submit" id="btn-submit" class="btn btn-primary">
            <i class="ti ti-device-floppy"></i> Registrar asiento
        </button>
    </div>
</form>
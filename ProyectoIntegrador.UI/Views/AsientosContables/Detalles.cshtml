@model AsientoContableViewModel
@{
    ViewData["Title"] = $"Asiento N° {Model.Numero}";
    var clienteId = ViewBag.ClienteId as Guid? ?? Guid.Empty;
    var clienteNombre = ViewBag.ClienteNombre as string ?? string.Empty;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-1"><i class="ti ti-file-invoice"></i> Asiento N° @Model.Numero</h2>
        @if (!string.IsNullOrWhiteSpace(clienteNombre))
        {
            <div class="text-secondary">@clienteNombre</div>
        }
    </div>
    <a asp-action="Index" asp-route-clienteId="@clienteId" class="btn btn-outline-azure">
        <i class="ti ti-arrow-left"></i> Volver al Libro Diario
    </a>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success alert-dismissible mb-3">
        <i class="ti ti-circle-check"></i> @exito
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible mb-3">
        <i class="ti ti-alert-circle"></i> @error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 align-items-stretch">
    @* Información General *@
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h3 class="card-title mb-0"><i class="ti ti-info-circle"></i> Información general</h3>
                @if (Model.Estado == "Confirmado")
                {
                    <span class="badge bg-success-lt text-success">
                        <i class="ti ti-circle-check"></i> Confirmado
                    </span>
                }
                else
                {
                    <span class="badge bg-red-lt text-danger">
                        <i class="ti ti-circle-x"></i> Revertido
                    </span>
                }
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="text-secondary small">Número</div>
                        <div class="fw-bold fs-3 text-azure">@Model.Numero</div>
                    </div>
                    <div class="col-6">
                        <div class="text-secondary small">Fecha</div>
                        <div class="fw-semibold">@Model.Fecha.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="col-12">
                        <div class="text-secondary small">Glosa</div>
                        <div class="text-wrap">@Model.Glosa</div>
                    </div>
                </div>
                @if (Model.AsientoOrigenId.HasValue)
                {
                    <div class="alert alert-azure mt-3 mb-0">
                        <i class="ti ti-info-circle"></i>
                        <strong>Reversión:</strong> este asiento se generó como inverso de un asiento anterior.
                    </div>
                }
            </div>
        </div>
    </div>

    @* Líneas del Asiento *@
    <div class="col-md-8">
        <div class="card h-100">
            <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                <h3 class="card-title mb-0"><i class="ti ti-list-details"></i> Líneas del asiento</h3>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-secondary small">Totales</span>
                    <span class="badge bg-success-lt text-success">Debe: @Model.TotalDebe.ToString("N2")</span>
                    <span class="badge bg-danger-lt text-danger">Haber: @Model.TotalHaber.ToString("N2")</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Cuenta</th>
                                <th class="text-end">Debe</th>
                                <th class="text-end">Haber</th>
                                <th class="text-center">Moneda</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var linea in Model.Lineas)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@linea.CodigoCuenta</div>
                                        <div class="text-secondary small">@linea.NombreCuenta</div>
                                    </td>
                                    <td class="text-end">
                                        @if (linea.Debe > 0)
                                        {
                                            <span class="fw-semibold text-success">@linea.Debe.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (linea.Haber > 0)
                                        {
                                            <span class="fw-semibold text-danger">@linea.Haber.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary-lt">@linea.Moneda</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th>TOTALES</th>
                                <th class="text-end">@Model.TotalDebe.ToString("N2")</th>
                                <th class="text-end">@Model.TotalHaber.ToString("N2")</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            @if (Model.Estado == "Confirmado")
            {
                <div class="card-footer bg-warning-lt">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <div class="text-warning fw-semibold">
                                <i class="ti ti-alert-triangle"></i> Reversión del asiento
                            </div>
                            <div class="text-secondary">
                                Esta acción crea un asiento inverso (Debe ↔ Haber) y marca el asiento actual como
                                <strong>Revertido</strong>. No se puede deshacer.
                            </div>
                        </div>
                        <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalRevertir">
                            <i class="ti ti-arrows-exchange"></i> Revertir asiento
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="card-footer bg-azure-lt">
                    <div class="text-azure">
                        <i class="ti ti-info-circle"></i>
                        Este asiento ya ha sido revertido y no puede ser modificado.
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* Modal de Confirmación de Reversión *@
<div class="modal fade" id="modalRevertir" tabindex="-1" aria-labelledby="modalRevertirLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning-lt">
                <h5 class="modal-title text-warning" id="modalRevertirLabel">
                    <i class="ti ti-alert-triangle"></i> Confirmar Reversión
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Revertir" asp-route-id="@Model.Id" asp-route-clienteId="@clienteId" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="alert alert-warning mb-3">
                        <i class="ti ti-alert-circle"></i>
                        <strong>¡Atención!</strong> Esta acción es irreversible.
                    </div>
                    <p>¿Está seguro que desea revertir el <strong>Asiento N° @Model.Numero</strong>?</p>
                    <p class="text-secondary small mb-0">
                        Se creará un nuevo asiento con las líneas invertidas (Debe ↔ Haber) 
                        y este asiento quedará marcado como "Revertido".
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost-secondary" data-bs-dismiss="modal">
                        <i class="ti ti-x"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-warning">
                        <i class="ti ti-arrows-exchange"></i> Sí, Revertir Asiento
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
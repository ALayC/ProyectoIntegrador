@model ImportacionIniciarViewModel
@{
    ViewData["Title"] = "Importar asientos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-1"><i class="ti ti-file-import"></i> Importar asientos</h2>
        <div class="text-secondary">@Model.ClienteNombre</div>
    </div>
    <a asp-controller="AsientosContables" asp-action="Index" asp-route-clienteId="@Model.ClienteId"
       class="btn btn-outline-azure">
        <i class="ti ti-arrow-left"></i> Volver al Libro Diario
    </a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        <i class="ti ti-alert-circle me-2"></i>@error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">

    @* Paso 1: Descargar template *@
    <div class="col-12 col-md-5">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title"><span class="badge bg-azure me-2">1</span>Descargar template</h3>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <p class="text-secondary mb-0">
                    Descargue el archivo Excel personalizado con las cuentas imputables de <strong>@Model.ClienteNombre</strong>.
                    El archivo incluye un desplegable con todos los códigos de cuenta válidos para evitar errores.
                </p>
                <ul class="text-secondary small mb-0">
                    <li>Columna <strong>NumAsiento</strong>: número que agrupa las líneas de un mismo asiento.</li>
                    <li>Columna <strong>CodigoCuenta</strong>: seleccione del desplegable.</li>
                    <li>Cada asiento debe balancear (Debe = Haber) y tener al menos 2 líneas.</li>
                </ul>
                <div class="mt-auto">
                    <a asp-action="DescargarTemplate" asp-route-clienteId="@Model.ClienteId"
                       class="btn btn-outline-azure w-100">
                        <i class="ti ti-download me-1"></i> Descargar template Excel
                    </a>
                </div>
            </div>
        </div>
    </div>

    @* Paso 2: Subir archivo *@
    <div class="col-12 col-md-7">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title"><span class="badge bg-azure me-2">2</span>Subir archivo completado</h3>
            </div>
            <div class="card-body">
                <form asp-action="Parsear" asp-route-clienteId="@Model.ClienteId"
                      method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="clienteId" value="@Model.ClienteId" />

                    <div class="mb-3">
                        <label class="form-label required">Ejercicio contable</label>
                        @if (Model.Ejercicios.Count == 0)
                        {
                            <div class="alert alert-warning py-2 mb-0">
                                <i class="ti ti-alert-triangle me-1"></i>
                                No hay ejercicios disponibles. Cree un ejercicio contable antes de importar.
                            </div>
                        }
                        else
                        {
                            <select name="ejercicioId" class="form-select" required>
                                <option value="">— Seleccione un ejercicio —</option>
                                @foreach (var ej in Model.Ejercicios)
                                {
                                    <option value="@ej.Id">
                                        @ej.FechaInicio.Year – @ej.FechaFin.Year (@ej.Estado)
                                    </option>
                                }
                            </select>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label required">Archivo Excel (.xlsx)</label>
                        <input type="file" name="archivo" accept=".xlsx"
                               class="form-control" id="archivoInput" required />
                        <div class="form-hint">Suba el template descargado con los datos completos.</div>
                    </div>

                    <div id="file-info" class="alert alert-info py-2 d-none">
                        <i class="ti ti-file-spreadsheet me-1"></i>
                        <span id="file-name"></span>
                    </div>

                    <button type="submit" class="btn btn-azure w-100"
                            @(Model.Ejercicios.Count == 0 ? "disabled" : "")>
                        <i class="ti ti-eye me-1"></i> Ver vista previa
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.getElementById('archivoInput')?.addEventListener('change', function () {
            var info = document.getElementById('file-info');
            var name = document.getElementById('file-name');
            if (this.files.length > 0) {
                name.textContent = this.files[0].name + ' (' + (this.files[0].size / 1024).toFixed(1) + ' KB)';
                info.classList.remove('d-none');
            } else {
                info.classList.add('d-none');
            }
        });
    </script>
}

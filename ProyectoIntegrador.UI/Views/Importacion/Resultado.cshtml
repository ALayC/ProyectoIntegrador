@model ResultadoImportacionViewModel
@{
    ViewData["Title"] = "Resultado de importación";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-1"><i class="ti ti-clipboard-check"></i> Resultado de importación</h2>
        <div class="text-secondary">@Model.ClienteNombre</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Importacion" asp-action="Iniciar" asp-route-clienteId="@Model.ClienteId"
           class="btn btn-outline-azure">
            <i class="ti ti-file-import me-1"></i> Nueva importación
        </a>
        <a asp-controller="AsientosContables" asp-action="Index" asp-route-clienteId="@Model.ClienteId"
           class="btn btn-azure">
            <i class="ti ti-book me-1"></i> Ver Libro Diario
        </a>
    </div>
</div>

@* Resumen de resultado *@
<div class="row g-2 mb-4">
    <div class="col-6 col-md-3">
        <div class="card card-sm text-center">
            <div class="card-body py-3">
                <div class="text-muted small mb-1">Enviados</div>
                <div class="fs-2 fw-bold">@(Model.TotalEnviados + Model.TotalRechazados)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-sm text-center">
            <div class="card-body py-3">
                <div class="text-muted small mb-1">Creados</div>
                <div class="fs-2 fw-bold text-success">@Model.TotalCreados</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-sm text-center">
            <div class="card-body py-3">
                <div class="text-muted small mb-1">Rechazados</div>
                <div class="fs-2 fw-bold text-secondary">@Model.TotalRechazados</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-sm text-center">
            <div class="card-body py-3">
                <div class="text-muted small mb-1">Errores</div>
                <div class="fs-2 fw-bold @(Model.TotalErrores > 0 ? "text-danger" : "text-muted")">@Model.TotalErrores</div>
            </div>
        </div>
    </div>
</div>

@if (Model.TotalCreados > 0 && Model.TotalErrores == 0 && Model.TotalRechazados == 0)
{
    <div class="alert alert-success mb-3">
        <i class="ti ti-circle-check me-2"></i>
        <strong>Importación completada.</strong> Se crearon @Model.TotalCreados asiento(s) correctamente.
    </div>
}
else if (Model.TotalCreados == 0 && Model.TotalRechazados > 0 && Model.TotalErrores == 0)
{
    <div class="alert alert-secondary mb-3">
        <i class="ti ti-info-circle me-2"></i>
        Todos los asientos fueron rechazados. No se creó ningún registro.
    </div>
}
else if (Model.TotalErrores > 0)
{
    <div class="alert alert-warning mb-3">
        <i class="ti ti-alert-triangle me-2"></i>
        <strong>@Model.TotalErrores asiento(s) fallaron</strong> al ser procesados por el servidor.
        Los demás se procesaron correctamente.
    </div>
}

@* Detalle por asiento *@
@if (Model.Resultados.Count > 0)
{
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Detalle por asiento</h3>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:120px"># Asiento</th>
                        <th style="width:140px">Estado</th>
                        <th style="width:160px">N° generado</th>
                        <th>Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Resultados)
                    {
                        <tr>
                            <td><strong>@r.NumAsiento</strong></td>
                            <td>
                                @switch (r.Estado)
                                {
                                    case "Creado":
                                        <span class="badge bg-success-lt">
                                            <i class="ti ti-check me-1"></i>Creado
                                        </span>
                                        break;
                                    case "Rechazado":
                                        <span class="badge bg-secondary-lt">
                                            <i class="ti ti-minus me-1"></i>Rechazado
                                        </span>
                                        break;
                                    case "Error":
                                        <span class="badge bg-danger-lt">
                                            <i class="ti ti-x me-1"></i>Error
                                        </span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (r.NumeroAsientoGenerado.HasValue)
                                {
                                    <span class="text-azure fw-semibold">N° @r.NumeroAsientoGenerado</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(r.MensajeError))
                                {
                                    <span class="text-danger small"><i class="ti ti-alert-circle me-1"></i>@r.MensajeError</span>
                                }
                                else if (r.Estado == "Rechazado")
                                {
                                    <span class="text-muted small">Omitido por el usuario</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

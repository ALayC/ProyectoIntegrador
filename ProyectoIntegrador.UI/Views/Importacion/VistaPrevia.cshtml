@model ImportacionVistaPreviaViewModel
@{
    ViewData["Title"] = "Vista previa de importación";
}

@section Scripts {
    <script>
        (function () {
            function actualizarContadores() {
                var checks = document.querySelectorAll('.asiento-check');
                var seleccionados = Array.from(checks).filter(function (c) { return c.checked; }).length;
                var spanSel = document.getElementById('span-seleccionados');
                if (spanSel) spanSel.textContent = seleccionados;
            }

            document.getElementById('btn-aceptar-todos')?.addEventListener('click', function () {
                document.querySelectorAll('.asiento-check:not(:disabled)').forEach(function (c) { c.checked = true; });
                actualizarContadores();
            });

            document.getElementById('btn-rechazar-todos')?.addEventListener('click', function () {
                document.querySelectorAll('.asiento-check:not(:disabled)').forEach(function (c) { c.checked = false; });
                actualizarContadores();
            });

            document.querySelectorAll('.asiento-check').forEach(function (c) {
                c.addEventListener('change', actualizarContadores);
            });

            actualizarContadores();
        })();
    </script>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-1"><i class="ti ti-eye"></i> Vista previa de importación</h2>
        <div class="text-secondary">
            @Model.ClienteNombre &mdash; Ejercicio: @Model.EjercicioDescripcion
        </div>
    </div>
    <a asp-action="Iniciar" asp-route-clienteId="@Model.ClienteId" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i>Volver
    </a>
</div>

@* Resumen *@
<div class="row g-2 mb-3">
    <div class="col-6 col-md-3">
        <div class="card card-sm text-center">
            <div class="card-body py-2">
                <div class="text-muted small">Total asientos</div>
                <div class="fs-3 fw-bold">@Model.Asientos.Count</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-sm text-center">
            <div class="card-body py-2">
                <div class="text-muted small">Válidos</div>
                <div class="fs-3 fw-bold text-success">@Model.TotalValidos</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-sm text-center">
            <div class="card-body py-2">
                <div class="text-muted small">Con errores</div>
                <div class="fs-3 fw-bold text-danger">@Model.TotalInvalidos</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card card-sm text-center">
            <div class="card-body py-2">
                <div class="text-muted small">Seleccionados</div>
                <div class="fs-3 fw-bold text-azure" id="span-seleccionados">@Model.TotalValidos</div>
            </div>
        </div>
    </div>
</div>

@if (Model.TotalInvalidos > 0)
{
    <div class="alert alert-warning">
        <i class="ti ti-alert-triangle me-2"></i>
        <strong>@Model.TotalInvalidos asiento(s) tienen errores</strong> y no pueden ser importados.
        Corrija los datos en el Excel y vuelva a subir el archivo si desea incluirlos.
    </div>
}

@* Barra de acciones *@
<form asp-action="Confirmar" method="post" id="form-confirmacion">
    @Html.AntiForgeryToken()

    <div class="card mb-3">
        <div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div class="d-flex gap-2">
                <button type="button" id="btn-aceptar-todos" class="btn btn-sm btn-success">
                    <i class="ti ti-check-all me-1"></i> Aceptar todos
                </button>
                <button type="button" id="btn-rechazar-todos" class="btn btn-sm btn-outline-danger">
                    <i class="ti ti-x me-1"></i> Rechazar todos
                </button>
            </div>
            <button type="submit" class="btn btn-azure">
                <i class="ti ti-send me-1"></i> Confirmar importación
            </button>
        </div>
    </div>

    @* Tabla de asientos *@
    @foreach (var asiento in Model.Asientos)
    {
        <div class="card mb-2 @(asiento.EsValido ? "" : "border-danger")">
            <div class="card-header py-2 d-flex flex-wrap align-items-center gap-2 justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    @if (asiento.EsValido)
                    {
                        <input type="checkbox"
                               class="form-check-input asiento-check mt-0"
                               name="seleccionados"
                               value="@asiento.NumAsiento"
                               checked />
                    }
                    else
                    {
                        <input type="checkbox"
                               class="form-check-input asiento-check mt-0"
                               disabled
                               title="No se puede seleccionar: el asiento tiene errores." />
                    }
                    <strong>Asiento #@asiento.NumAsiento</strong>
                    <span class="text-secondary">@asiento.Fecha.ToString("dd/MM/yyyy")</span>
                    <span class="text-muted">— @asiento.Glosa</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (asiento.EsValido)
                    {
                        <span class="badge bg-success-lt"><i class="ti ti-check me-1"></i>Válido</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-lt"><i class="ti ti-x me-1"></i>Con errores</span>
                    }
                </div>
            </div>

            @if (!asiento.EsValido)
            {
                <div class="px-3 pt-2 pb-0">
                    @foreach (var err in asiento.Errores)
                    {
                        <div class="alert alert-danger py-1 px-2 mb-1 small">
                            <i class="ti ti-alert-circle me-1"></i>@err
                        </div>
                    }
                </div>
            }

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Cuenta</th>
                                <th class="text-end">Debe</th>
                                <th class="text-end">Haber</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var linea in asiento.Lineas)
                            {
                                <tr class="@(linea.CuentaContableId is null ? "table-danger" : "")">
                                    <td><code>@linea.CodigoCuenta</code></td>
                                    <td>
                                        @if (linea.CuentaContableId is null)
                                        {
                                            <span class="text-danger"><i class="ti ti-alert-circle me-1"></i>No encontrada</span>
                                        }
                                        else
                                        {
                                            @linea.NombreCuenta
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (linea.Debe > 0)
                                        {
                                            <span>@linea.Debe.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (linea.Haber > 0)
                                        {
                                            <span>@linea.Haber.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="2" class="text-end">Totales:</td>
                                <td class="text-end">@asiento.TotalDebe.ToString("N2")</td>
                                <td class="text-end">@asiento.TotalHaber.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }

    @* Botón de confirmación al pie *@
    <div class="d-flex justify-content-end gap-2 mt-3">
        <a asp-action="Iniciar" asp-route-clienteId="@Model.ClienteId" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i> Cancelar
        </a>
        <button type="submit" class="btn sg-btn-primary-dark">
            <i class="ti ti-send me-1"></i>Confirmar importación
        </button>
    </div>

</form>

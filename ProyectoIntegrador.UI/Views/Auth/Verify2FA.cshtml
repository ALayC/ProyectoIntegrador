@model Verify2FAViewModel
@{
    ViewData["Title"] = "Verificación en dos pasos";
    Layout = "_AuthLayout";
}

<div class="card card-md sg-auth-card">
    <div class="card-body">
        <div class="text-center mb-4">
            <span class="avatar avatar-lg bg-azure-lt mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-shield-lock" width="28" height="28" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                    <path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3"></path>
                    <circle cx="12" cy="11" r="1"></circle>
                    <line x1="12" y1="12" x2="12" y2="14.5"></line>
                </svg>
            </span>
            <h2 class="h2 mb-1">Verificación en dos pasos</h2>
            <p class="text-secondary">
                Ingresá el código de 6 dígitos que enviamos a tu email.
            </p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        }

        <form asp-action="Verify2FA" method="post" autocomplete="off" novalidate>
            <input asp-for="TempToken" type="hidden" />

            <div class="mb-3">
                <label asp-for="Codigo" class="form-label">Código de verificación</label>
                <input asp-for="Codigo"
                       class="form-control form-control-lg text-center"
                       placeholder="000000"
                       maxlength="6"
                       inputmode="numeric"
                       pattern="\d{6}"
                       autocomplete="one-time-code"
                       autofocus />
                <span asp-validation-for="Codigo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-check cursor-pointer">
                    <input asp-for="RecordarDispositivo" class="form-check-input" type="checkbox" />
                    <span class="form-check-label text-secondary">
                        Recordar este dispositivo por 7 días
                    </span>
                </label>
            </div>

            <div class="form-footer mt-4">
                <button type="submit" class="btn btn-azure w-100">Verificar</button>
            </div>
        </form>

        <div class="text-center mt-3">
            <small class="text-secondary">
                ¿No recibiste el código?
                <a asp-action="Login" class="link-azure">Volver al inicio de sesión</a>
            </small>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Auto-submit cuando se completan los 6 dígitos
        document.getElementById('Codigo').addEventListener('input', function () {
            if (this.value.length === 6 && /^\d{6}$/.test(this.value)) {
                this.closest('form').submit();
            }
        });
    </script>
}

@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Acceso</title>
    <link href="~/tabler/dist/css/tabler.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/tabler/dist/css/tabler-vendors.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        .login-wrapper {
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* ── LEFT PANEL ── */
        .login-left {
            flex: 0 0 50%;
            width: 50%;
            background: #1a3a5c;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 48px 56px;
            color: #fff;
        }

        .login-left::before {
            content: '';
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            border: 64px solid rgba(255,255,255,.05);
            top: -140px;
            right: -140px;
            pointer-events: none;
        }

        .login-left::after {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            border: 50px solid rgba(255,255,255,.05);
            bottom: -100px;
            left: -90px;
            pointer-events: none;
        }

        .login-logo-box {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: rgba(255,255,255,.15);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 24px;
            font-size: 28px;
            color: #fff;
            flex-shrink: 0;
        }

        .login-brand-name {
            font-size: 24px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 8px;
        }

        .login-tagline {
            font-size: 14px;
            color: rgba(255,255,255,.5);
            margin-bottom: 40px;
            line-height: 1.6;
            max-width: 340px;
        }

        .login-features {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .login-feature-item {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .login-feature-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: rgba(255,255,255,.1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: rgba(255,255,255,.8);
            flex-shrink: 0;
        }

        .login-feature-text {
            font-size: 13px;
            color: rgba(255,255,255,.6);
        }

        .login-copyright {
            margin-top: auto;
            padding-top: 48px;
            font-size: 12px;
            color: rgba(255,255,255,.3);
        }

        /* ── RIGHT PANEL ── */
        .login-right {
            flex: 0 0 50%;
            width: 50%;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 40px;
            overflow-y: auto;
        }

        .login-form-wrapper {
            width: 100%;
            max-width: 400px;
        }

        .login-title {
            font-size: 22px;
            font-weight: 600;
            color: #1a3a5c;
            margin-bottom: 4px;
        }

        .login-subtitle {
            font-size: 13px;
            color: #64748b;
            margin-bottom: 28px;
        }

        .login-input-wrapper {
            position: relative;
        }

        .login-input-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 16px;
            pointer-events: none;
            z-index: 2;
        }

        .login-input-wrapper .form-control {
            padding-left: 36px;
        }

        .login-input-wrapper .form-control:focus {
            border-color: #1a3a5c;
            box-shadow: 0 0 0 3px rgba(26,58,92,.08);
        }

        .btn-login {
            background: #1a3a5c;
            color: #fff;
            border: none;
            width: 100%;
            padding: 10px 16px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            cursor: pointer;
            transition: background .2s;
        }

        .btn-login:hover {
            background: #15304f;
            color: #fff;
        }

        .btn-google {
            width: 100%;
            border: 0.5px solid #e2e8f0;
            background: #fff;
            color: #374151;
            padding: 9px 16px;
            border-radius: 6px;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            text-decoration: none;
            transition: background .2s;
        }

        .btn-google:hover {
            background: #f8fafc;
            color: #374151;
        }

        .login-divider {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 20px 0;
            color: #cbd5e1;
            font-size: 12px;
        }

        .login-divider::before,
        .login-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #f1f5f9;
        }

        .login-register-block {
            border-top: 0.5px solid #f1f5f9;
            padding-top: 20px;
            margin-top: 20px;
        }

        .login-register-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #94a3b8;
            margin-bottom: 10px;
        }

        .btn-register {
            width: 100%;
            border: 0.5px solid #1a3a5c;
            color: #1a3a5c;
            background: transparent;
            padding: 9px 16px;
            border-radius: 6px;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            text-decoration: none;
            transition: background .2s;
        }

        .btn-register:hover {
            background: #f0f4f8;
            color: #1a3a5c;
        }

        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .login-left {
                display: none;
            }

            .login-right {
                width: 100%;
                background: #f0f4f8;
                padding: 32px 16px;
            }

            .login-form-wrapper {
                background: #fff;
                border-radius: 12px;
                padding: 32px 24px;
                box-shadow: 0 4px 24px rgba(0,0,0,.06);
            }
        }
    </style>
</head>
<body>
    <div class="login-wrapper">

        <!-- Panel izquierdo: marca -->
        <div class="login-left" data-aos="fade-right" data-aos-duration="500">
            <div class="login-logo-box">
                <i class="ti ti-report-money"></i>
            </div>
            <div class="login-brand-name">SIG Contable</div>
            <div class="login-tagline">Sistema Integrado de Gestión<br>Contable y Fiscal — Uruguay</div>

            <ul class="login-features">
                <li class="login-feature-item">
                    <span class="login-feature-icon"><i class="ti ti-users"></i></span>
                    <span class="login-feature-text">Gestión contable de clientes</span>
                </li>
                <li class="login-feature-item">
                    <span class="login-feature-icon"><i class="ti ti-file-invoice"></i></span>
                    <span class="login-feature-text">ACtualizacion automatica de tipos de cambio BCU</span>
                </li>
                <li class="login-feature-item">
                    <span class="login-feature-icon"><i class="ti ti-chart-bar"></i></span>
                    <span class="login-feature-text">Reportesen tiempo real</span>
                </li>
                <li class="login-feature-item">
                    <span class="login-feature-icon"><i class="ti ti-lock"></i></span>
                    <span class="login-feature-text">Login con tu cuenta de Google</span>
                </li>
                <li class="login-feature-item">
                    <span class="login-feature-icon"><i class="ti ti-lock"></i></span>
                    <span class="login-feature-text">Acceso seguro con roles y permisos</span>
                </li>
            </ul>

            <div class="login-copyright">&copy; @DateTime.Now.Year SIG Contable — Uruguay</div>
        </div>

        <!-- Panel derecho: formulario -->
        <div class="login-right" data-aos="fade-left" data-aos-duration="500">
            <div class="login-form-wrapper">
                <div class="login-title">Iniciar sesión</div>
                <div class="login-subtitle">Ingresá tus credenciales para continuar</div>

                @if (TempData["AuthExito"] != null)
                {
                    <div class="text-success small mb-3">@TempData["AuthExito"]</div>
                }

                <form asp-action="Login" method="post" autocomplete="off" novalidate>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label" style="font-size:13px;font-weight:500;color:#374151;"></label>
                        <div class="login-input-wrapper">
                            <i class="ti ti-mail login-input-icon"></i>
                            <input asp-for="Email" class="form-control form-control-sm" placeholder="nombre@ejemplo.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label" style="font-size:13px;font-weight:500;color:#374151;">
                            Contraseña
                            <span class="form-label-description">
                                <a asp-action="ForgotPassword" style="color:#1a3a5c;font-size:12px;">¿Olvidaste tu contraseña?</a>
                            </span>
                        </label>
                        <div class="login-input-wrapper">
                            <i class="ti ti-lock login-input-icon"></i>
                            <input asp-for="Password" class="form-control form-control-sm" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        var mensaje = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
                        if (!string.IsNullOrWhiteSpace(mensaje))
                        {
                            if (ViewBag.EmailNoConfirmado != null)
                            {
                                <div class="alert alert-warning alert-dismissible mt-3" role="alert">
                                    <div class="d-flex">
                                        <div>
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon alert-icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"></path>
                                                <path d="M3 7l9 6l9 -6"></path>
                                            </svg>
                                        </div>
                                        <div>
                                            <h4 class="alert-title">Email no confirmado</h4>
                                            <div class="text-secondary">@mensaje</div>
                                            <div class="mt-2">
                                                <a asp-action="ResendConfirmation" asp-route-email="@ViewBag.EmailNoConfirmado" class="btn btn-warning btn-sm">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                        <path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4"></path>
                                                        <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"></path>
                                                    </svg>
                                                    Reenviar email de confirmación
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-danger small mt-2">@mensaje</div>
                            }
                        }
                    }

                    <div class="mt-4">
                        <button type="submit" class="btn-login">
                            <i class="ti ti-login"></i> Ingresar
                        </button>
                    </div>

                    <div class="text-center mt-3">
                        <small style="color:#94a3b8;font-size:11px;">
                            ¿No recibiste el email de confirmación?
                            <a asp-action="ResendConfirmation" style="color:#1a3a5c;">Reenviar</a>
                        </small>
                    </div>
                </form>

                <div class="login-divider">o</div>

                <a href="/Auth/LoginGoogle" class="btn-google">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                        <path fill="none" d="M0 0h48v48H0z" />
                    </svg>
                    Ingresar con Google
                </a>

                <div class="login-register-block">
                    <div class="login-register-label">¿No tenés cuenta?</div>
                    <a asp-action="Register" class="btn-register">
                        <i class="ti ti-user-plus"></i> Crear cuenta
                    </a>
                </div>
            </div>
        </div>

    </div>

    <script src="~/tabler/dist/js/tabler.min.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script>
        AOS.init({ once: true });
    </script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>

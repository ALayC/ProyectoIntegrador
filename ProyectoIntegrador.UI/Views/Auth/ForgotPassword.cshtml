@model ProyectoIntegrador.UI.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "¿Olvidaste tu contraseña?";
    Layout = "_AuthLayout";
}

<div class="card card-md sg-auth-card">
    <div class="card-body">
        <h2 class="h2 text-center mb-4">
            <i class="ti ti-lock-question"></i> ¿Olvidaste tu contraseña?
        </h2>

        <p class="text-secondary text-center mb-4">
            Ingresá tu email y te enviaremos un enlace para restablecer tu contraseña.
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        }

        <form asp-action="ForgotPassword" method="post" autocomplete="off" novalidate>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="nombre@ejemplo.com" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-footer mt-4">
                <button type="submit" class="btn sg-btn-primary-dark w-100">
                    <i class="ti ti-mail"></i> Enviar enlace de restablecimiento
                </button>
            </div>
        </form>

        <div class="text-center mt-3">
            <a asp-action="Login" class="link-azure">
                <i class="ti ti-arrow-left"></i> Volver al inicio de sesión
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

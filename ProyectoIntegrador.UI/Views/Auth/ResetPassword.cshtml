@model ProyectoIntegrador.UI.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="page-wrapper">
    <div class="page-body">
        <div class="container-xl d-flex flex-column justify-content-center">
            <div class="row row-deck row-cards">
                <div class="col-md-6 col-lg-4 mx-auto">
                    <div class="card shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="card-title mb-4 text-center">
                                <i class="ti ti-lock"></i> Restablecer contraseña
                            </h2>

                            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                            <form asp-action="ResetPassword" method="post" class="mb-3">
                                <input type="hidden" asp-for="Token" />

                                <div class="mb-3">
                                    <label asp-for="NuevaContraseña" class="form-label"></label>
                                    <input asp-for="NuevaContraseña" type="password" class="form-control" placeholder="Ingresa tu nueva contraseña" autofocus />
                                    <span asp-validation-for="NuevaContraseña" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ConfirmarContraseña" class="form-label"></label>
                                    <input asp-for="ConfirmarContraseña" type="password" class="form-control" placeholder="Confirma tu contraseña" />
                                    <span asp-validation-for="ConfirmarContraseña" class="text-danger"></span>
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn sg-btn-primary-dark">
                                        <i class="ti ti-check"></i> Actualizar contraseña
                                    </button>
                                </div>
                            </form>

                            <div class="text-center text-secondary small">
                                <p>¿Recordaste tu contraseña? <a asp-action="Login" class="link-azure">Iniciar sesión</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Integrado Contable y Fiscal</title>
    <link href="~/tabler/dist/css/tabler.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/tabler/dist/css/tabler-vendors.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="https://unpkg.com/nprogress@0.2.0/nprogress.css" rel="stylesheet" />
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" />
</head>
<body class="sg-body">
    <div class="page">
        <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark sg-sidebar">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="Mostrar menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <h1 class="navbar-brand navbar-brand-autodark mb-0">
                    <a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none fw-semibold">
                        SIG Contable
                    </a>
                    <p class="sg-sidebar-subtitle">Sistema Integrado Contable</p>
                </h1>
                <div class="collapse navbar-collapse d-flex flex-column justify-content-between" id="sidebar-menu" style="min-height:calc(100vh - 80px)">
                    @{
                        var ctxClienteIdRaw = ViewData["ClienteId"];
                        Guid? ctxClienteId = ctxClienteIdRaw is Guid cg ? cg : (Guid?)null;
                        var ctxClienteNombre = ViewData["ClienteNombre"] as string;
                        var ctxController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                        var ctxAction    = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

                        bool sgIsResumen      = ctxController == "Clientes" && ctxAction == "Detalles";
                        bool sgIsContabilidad = ctxController is "LibroMayor" or "AsientosContables" or "EstadoResultados" or "BalanceGeneral" or "Importacion";
                        bool sgIsFiscal       = ctxController is "LiquidacionIva" or "Comprobantes";
                        bool sgIsPlan         = (ctxController == "Clientes" && ctxAction == "PlanDeCuentas") || ctxController == "CuentasContables";
                        bool sgIsEjercicios   = ctxController == "Ejercicios";
                    }
                    <ul class="navbar-nav pt-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <span class="nav-link-icon"><i class="ti ti-layout-dashboard"></i></span>
                                <span class="nav-link-title">Panel principal</span>
                            </a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (ctxClienteId.HasValue && !string.IsNullOrEmpty(ctxClienteNombre))
                            {
                                <li class="nav-item">
                                    <div class="px-3 pt-1 pb-1">
                                        <div style="font-size:10px;text-transform:uppercase;letter-spacing:.08em;font-weight:600;color:rgba(255,255,255,.35);">
                                            @ctxClienteNombre
                                        </div>
                                    </div>
                                    <ul class="navbar-nav ps-2">
                                        <li class="nav-item">
                                            <a class="nav-link @(sgIsResumen ? "active" : "")"
                                               asp-controller="Clientes" asp-action="Detalles" asp-route-id="@ctxClienteId">
                                                <span class="nav-link-icon"><i class="ti ti-layout-dashboard"></i></span>
                                                <span class="nav-link-title">Resumen</span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link @(sgIsContabilidad ? "active" : "")"
                                               href="@Url.Action("Detalles", "Clientes", new { id = ctxClienteId })#tab-contabilidad">
                                                <span class="nav-link-icon"><i class="ti ti-book"></i></span>
                                                <span class="nav-link-title">Contabilidad</span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link @(sgIsFiscal ? "active" : "")"
                                               href="@Url.Action("Detalles", "Clientes", new { id = ctxClienteId })#tab-fiscal">
                                                <span class="nav-link-icon"><i class="ti ti-receipt-tax"></i></span>
                                                <span class="nav-link-title">Fiscal</span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            @if (User.IsInRole("Auxiliar Contable"))
                                            {
                                                <a class="nav-link @(sgIsPlan ? "active" : "") sg-nav-bloqueado"
                                                   href="#" data-bs-toggle="modal" data-bs-target="#modal-sin-permiso"
                                                   style="opacity:.55;">
                                                    <span class="nav-link-icon"><i class="ti ti-list-tree"></i></span>
                                                    <span class="nav-link-title">Plan de Cuentas</span>
                                                    <span class="ms-1"><i class="ti ti-lock" style="font-size:11px;opacity:.7;"></i></span>
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="nav-link @(sgIsPlan ? "active" : "")"
                                                   asp-controller="Clientes" asp-action="PlanDeCuentas" asp-route-id="@ctxClienteId">
                                                    <span class="nav-link-icon"><i class="ti ti-list-tree"></i></span>
                                                    <span class="nav-link-title">Plan de Cuentas</span>
                                                </a>
                                            }
                                        </li>
                                        <li class="nav-item">
                                            @if (User.IsInRole("Auxiliar Contable"))
                                            {
                                                <a class="nav-link @(sgIsEjercicios ? "active" : "") sg-nav-bloqueado"
                                                   href="#" data-bs-toggle="modal" data-bs-target="#modal-sin-permiso"
                                                   style="opacity:.55;">
                                                    <span class="nav-link-icon"><i class="ti ti-calendar-stats"></i></span>
                                                    <span class="nav-link-title">Ejercicios Contables</span>
                                                    <span class="ms-1"><i class="ti ti-lock" style="font-size:11px;opacity:.7;"></i></span>
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="nav-link @(sgIsEjercicios ? "active" : "")"
                                                   asp-controller="Ejercicios" asp-action="Index" asp-route-clienteId="@ctxClienteId">
                                                    <span class="nav-link-icon"><i class="ti ti-calendar-stats"></i></span>
                                                    <span class="nav-link-title">Ejercicios Contables</span>
                                                </a>
                                            }
                                        </li>
                                    </ul>
                                </li>
                            }
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Usuarios" asp-action="Index">
                                        <span class="nav-link-icon"><i class="ti ti-user-cog"></i></span>
                                        <span class="nav-link-title">Usuarios</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Roles" asp-action="Index">
                                        <span class="nav-link-icon"><i class="ti ti-shield-check"></i></span>
                                        <span class="nav-link-title">Roles y Permisos</span>
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Contador") || User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ctxController == "Auxiliares" ? "active" : "")" asp-controller="Auxiliares" asp-action="Index">
                                        <span class="nav-link-icon"><i class="ti ti-users-group"></i></span>
                                        <span class="nav-link-title">Mis Auxiliares</span>
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="pb-3 px-3">
                            @{
                                var nombreUsuario = User.Identity.Name ?? "Usuario";
                                var inicial = nombreUsuario.Length > 0 ? nombreUsuario[0].ToString().ToUpper() : "U";
                            }
                            <div class="d-flex align-items-center gap-2 mb-2 px-1">
                                <div class="sg-avatar-initial">@inicial</div>
                                <div class="text-white" style="font-size:13px;opacity:.85;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@nombreUsuario</div>
                            </div>
                            <hr class="sg-sidebar-divider" />
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                <button type="submit" class="sg-logout-pill" title="Cerrar sesión">
                                    <i class="ti ti-logout"></i>
                                    <span>Cerrar sesión</span>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </aside>

        <div class="page-wrapper">
            <header class="navbar navbar-expand-md d-print-none border-bottom bg-white">
                <div class="container-xl">
                    <nav class="sg-breadcrumb-nav" aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a asp-controller="Home" asp-action="Index">Gestión</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">@(ViewData["Title"] ?? "Sistema")</li>
                        </ol>
                    </nav>
                    <div class="navbar-nav flex-row ms-auto order-md-last gap-1">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="nav-item d-flex align-items-center me-2 text-secondary" style="font-size:13px">@User.Identity.Name</span>
                            <a href="#" class="sg-topbar-icon" title="Notificaciones"><i class="ti ti-bell"></i></a>
                            <a href="#" class="sg-topbar-icon" title="Ayuda"><i class="ti ti-help-circle"></i></a>
                        }
                        else
                        {
                            <a class="btn btn-azure btn-sm me-2" asp-controller="Auth" asp-action="Login">Iniciar sesión</a>
                            <a class="btn btn-outline-azure btn-sm" asp-controller="Auth" asp-action="Register">Registrarse</a>
                        }
                    </div>
                </div>
            </header>

            <div class="page-header d-print-none">
                <div class="container-xl">
                    <div class="row g-2 align-items-center">
                        <div class="col">
                            <h2 class="page-title">@(ViewData["Title"] ?? "Sistema Integrado de Gestión")</h2>
                        </div>
                    </div>
                </div>
            </div>

            <div class="page-body">
                <div class="container-xl">
                    @if (TempData["Exito"] != null)
                    {
                        <div class="alert alert-success alert-dismissible" role="alert">
                            <div class="d-flex">
                                <div>@TempData["Exito"]</div>
                                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                            </div>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible" role="alert">
                            <div class="d-flex">
                                <div>@TempData["Error"]</div>
                                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                            </div>
                        </div>
                    }

                    <main role="main" class="pb-4">
                        @RenderBody()
                    </main>
                </div>
            </div>

            <footer class="footer footer-transparent d-print-none">
                <div class="container-xl text-secondary text-center py-3">
                    &copy; @DateTime.Now.Year - Sistema Integrado Contable y Fiscal
                </div>
            </footer>
        </div>
    </div>

    <button id="sg-back-top" aria-label="Ir arriba" title="Ir arriba">
        <i class="ti ti-arrow-up" style="font-size:1.1rem"></i>
    </button>

    <!-- Botón flotante Asistente IA -->
    <button id="ai-chat-toggle" type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#ai-chat"
            aria-controls="ai-chat"
            title="Asistente Contable"
            style="position:fixed;bottom:1.5rem;right:5rem;z-index:1049;width:48px;height:48px;border-radius:50%;background:#1a3a5c;color:#fff;border:none;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(0,0,0,.3);cursor:pointer;">
        <i class="ti ti-message-bolt" style="font-size:1.3rem"></i>
    </button>

    <!-- Offcanvas Asistente Contable -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="ai-chat" aria-labelledby="ai-chat-label" style="width:380px;">
        <div class="offcanvas-header" style="background:#1a3a5c;color:#fff;">
            <h5 class="offcanvas-title d-flex align-items-center gap-2" id="ai-chat-label">
                <i class="ti ti-brain"></i> Asistente Contable
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column p-0" style="height:calc(100% - 57px);">
            <div id="ai-messages" style="flex:1;overflow-y:auto;padding:1rem;">
                <div id="ai-welcome" class="text-center text-muted py-4">
                    <i class="ti ti-sparkles" style="font-size:2rem;color:#1a3a5c;"></i>
                    <p class="mt-2 mb-0" style="font-size:.9rem;">Preguntame sobre normativa DGI, IVA, o cualquier consulta contable.</p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 p-2" style="border-top:1px solid #e5e7eb;">
                <input id="ai-input" type="text" class="form-control form-control-sm" placeholder="Escribí tu consulta..." autocomplete="off" />
                <button id="ai-send" type="button" class="btn btn-sm" style="background:#1a3a5c;color:#fff;white-space:nowrap;">
                    <i class="ti ti-send"></i>
                </button>
            </div>
        </div>
    </div>

    <button id="sg-back-top" aria-label="Ir arriba" title="Ir arriba">
        <i class="ti ti-arrow-up" style="font-size:1.1rem"></i>
    </button>

    <script src="~/tabler/dist/js/tabler.min.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/nprogress@0.2.0/nprogress.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script>
        NProgress.configure({ showSpinner: false, speed: 300, trickleSpeed: 120 });
        document.addEventListener('DOMContentLoaded', function () {
            NProgress.done();
            AOS.init({ duration: 500, once: true, offset: 60, easing: 'ease-out-cubic' });

            // Alertas auto-cierre
            document.querySelectorAll('.alert-dismissible').forEach(function (el) {
                setTimeout(function () {
                    el.style.transition = 'opacity 0.5s ease';
                    el.style.opacity = '0';
                    setTimeout(function () { el.remove(); }, 500);
                }, 4000);
            });

            // Botón ir arriba
            var btn = document.getElementById('sg-back-top');
            if (btn) {
                window.addEventListener('scroll', function () {
                    btn.classList.toggle('sg-visible', window.scrollY > 280);
                }, { passive: true });
                btn.addEventListener('click', function () {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }
        });
        document.addEventListener('click', function (e) {
            var link = e.target.closest('a[href]');
            if (!link) return;
            var href = link.getAttribute('href');
            if (!href || href.startsWith('#') || href.startsWith('javascript') || link.target === '_blank') return;
            // Skip same-page hash links (e.g. /Clientes/Detalles/id#tab-x)
            try {
                var target = new URL(href, window.location.href);
                if (target.pathname === window.location.pathname && target.hash) return;
            } catch (ex) { }
            if (!e.ctrlKey && !e.metaKey && !e.shiftKey) NProgress.start();
        });
        document.addEventListener('submit', function () { NProgress.start(); });
    </script>
    <script src="https://unpkg.com/nprogress@0.2.0/nprogress.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script>
        NProgress.configure({ showSpinner: false, speed: 300, trickleSpeed: 120 });
        document.addEventListener('DOMContentLoaded', function () {
            NProgress.done();
            AOS.init({ duration: 500, once: true, offset: 60, easing: 'ease-out-cubic' });

            // Alertas auto-cierre
            document.querySelectorAll('.alert-dismissible').forEach(function (el) {
                setTimeout(function () {
                    el.style.transition = 'opacity 0.5s ease';
                    el.style.opacity = '0';
                    setTimeout(function () { el.remove(); }, 500);
                }, 4000);
            });

            // Botón flotante IA: ocultar cuando el offcanvas está abierto
            var aiChatEl = document.getElementById('ai-chat');
            var aiToggleBtn = document.getElementById('ai-chat-toggle');
            if (aiChatEl && aiToggleBtn) {
                aiChatEl.addEventListener('show.bs.offcanvas', function () {
                    aiToggleBtn.style.display = 'none';
                });
                aiChatEl.addEventListener('hide.bs.offcanvas', function () {
                    aiToggleBtn.style.display = 'flex';
                });
            }

            // Botón ir arriba
            var btn = document.getElementById('sg-back-top');
            if (btn) {
                window.addEventListener('scroll', function () {
                    btn.classList.toggle('sg-visible', window.scrollY > 280);
                }, { passive: true });
                btn.addEventListener('click', function () {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }
        });
        document.addEventListener('click', function (e) {
            var link = e.target.closest('a[href]');
            if (!link) return;
            var href = link.getAttribute('href');
            if (!href || href.startsWith('#') || href.startsWith('javascript') || link.target === '_blank') return;
            // Skip same-page hash links (e.g. /Clientes/Detalles/id#tab-x)
            try {
                var target = new URL(href, window.location.href);
                if (target.pathname === window.location.pathname && target.hash) return;
            } catch (ex) { }
            if (!e.ctrlKey && !e.metaKey && !e.shiftKey) NProgress.start();
        });
        document.addEventListener('submit', function () { NProgress.start(); });
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        (function () {
            var messagesEl = document.getElementById('ai-messages');
            var inputEl = document.getElementById('ai-input');
            var sendBtn = document.getElementById('ai-send');

            function addMsg(text, isUser) {
                var welcome = document.getElementById('ai-welcome');
                if (welcome) welcome.remove();

                var wrapper = document.createElement('div');
                wrapper.className = 'd-flex mb-2 ' + (isUser ? 'justify-content-end' : 'justify-content-start');

                var bubble = document.createElement('div');
                bubble.style.cssText = isUser
                    ? 'background:#1a3a5c;color:#fff;border-radius:12px 12px 2px 12px;padding:.5rem .85rem;max-width:85%;font-size:.875rem;white-space:pre-wrap;word-break:break-word;'
                    : 'background:#f1f5f9;color:#1f2937;border-radius:12px 12px 12px 2px;padding:.5rem .85rem;max-width:85%;font-size:.875rem;white-space:pre-wrap;word-break:break-word;';
                bubble.textContent = text;

                wrapper.appendChild(bubble);
                messagesEl.appendChild(wrapper);
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }

            function addTyping() {
                var existing = document.getElementById('typing-indicator');
                if (existing) existing.remove();

                var wrapper = document.createElement('div');
                wrapper.id = 'typing-indicator';
                wrapper.className = 'd-flex mb-2 justify-content-start';

                var bubble = document.createElement('div');
                bubble.style.cssText = 'background:#f1f5f9;color:#6b7280;border-radius:12px 12px 12px 2px;padding:.5rem .85rem;font-size:.875rem;';
                bubble.textContent = 'Escribiendo...';

                wrapper.appendChild(bubble);
                messagesEl.appendChild(wrapper);
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }

            async function send() {
                var text = inputEl.value.trim();
                if (!text) return;

                inputEl.value = '';
                sendBtn.disabled = true;
                inputEl.disabled = true;

                addMsg(text, true);
                addTyping();

                try {
                    var res = await fetch('/Ai/Chat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ pregunta: text })
                    });
                    var data = await res.json();
                    var typing = document.getElementById('typing-indicator');
                    if (typing) typing.remove();
                    addMsg(data.respuesta, false);
                } catch (e) {
                    var typing = document.getElementById('typing-indicator');
                    if (typing) typing.remove();
                    addMsg('Error al conectar con el asistente.', false);
                } finally {
                    sendBtn.disabled = false;
                    inputEl.disabled = false;
                    inputEl.focus();
                }
            }

            if (sendBtn) sendBtn.addEventListener('click', send);
            if (inputEl) {
                inputEl.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') { e.preventDefault(); send(); }
                });
            }
        })();
    </script>

    @* Modal: sin permiso (auxiliar contable) *@
    <div class="modal modal-blur fade" id="modal-sin-permiso" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body text-center py-3">
                    <div class="mb-3">
                        <span class="avatar avatar-lg rounded" style="background:#fff3cd;">
                            <i class="ti ti-lock fs-2" style="color:#f59f00;"></i>
                        </span>
                    </div>
                    <h4 class="mb-1">Acceso restringido</h4>
                    <p class="text-secondary mb-0">
                        No tenés permisos para acceder a esta sección.<br>
                        Contactá a tu contador para solicitar acceso.
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0 justify-content-center">
                    <button type="button" class="btn btn-azure px-4" data-bs-dismiss="modal">Entendido</button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

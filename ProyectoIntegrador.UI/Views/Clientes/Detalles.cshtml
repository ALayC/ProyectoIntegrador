@model ClienteListViewModel
@{
    ViewData["Title"] = "Detalle de Cliente";
    ViewData["ClienteId"] = Model.Id;
    ViewData["ClienteNombre"] = Model.RazonSocial;
    var esActivo = Model.Estado == "Activo";
    var esAuxiliar = User.IsInRole("Auxiliar Contable");
}

<style>
    /* ── Action cards ───────────────────────────────── */
    .sg-action-card {
        border-top: 3px solid #1a3a5c !important;
    }

        .sg-action-card.sg-card-fiscal {
            border-top-color: #206bc4 !important;
        }

    .sg-action-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: rgba(26, 58, 92, .08);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        color: #1a3a5c;
        flex-shrink: 0;
    }

        .sg-action-icon.sg-icon-fiscal {
            background: rgba(32, 107, 196, .09);
            color: #206bc4;
        }

    .sg-btn-primary-dark {
        background: #1a3a5c;
        color: #fff;
        border: none;
    }

        .sg-btn-primary-dark:hover,
        .sg-btn-primary-dark:focus {
            background: #15304e;
            color: #fff;
            border: none;
        }

    /* ── Info labels ────────────────────────────────── */
    .sg-detail-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--sg-text-muted);
        font-weight: 600;
        margin-bottom: 2px;
    }

    .sg-detail-value {
        font-weight: 600;
        color: var(--sg-text-dark);
    }

    /* ── Sidebar context nav tabs ───────────────────── */
    .sg-sidenav-tab {
        background: none;
        border: none;
        color: rgba(255,255,255,.55) !important;
        border-radius: 7px;
        transition: background .15s ease, color .15s ease;
    }

        .sg-sidenav-tab:hover {
            background: rgba(255,255,255,.12);
            color: #fff !important;
        }

        .sg-sidenav-tab.active {
            background: rgba(255,255,255,.15) !important;
            color: #fff !important;
            font-weight: 600;
        }

        .sg-sidenav-tab .nav-link-title {
            color: inherit !important;
        }

    /* ── Tab pane transition ────────────────────────── */
    .tab-pane {
        display: none;
    }

        .tab-pane.active {
            display: block;
        }

        .tab-pane.fade {
            opacity: 0;
            transition: opacity .15s ease;
        }

            .tab-pane.fade.show {
                opacity: 1;
            }
</style>

<!-- ── Client header ──────────────────────────────────────────────── -->
<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4" data-aos="fade-down">
    <div>
        <div class="sg-detail-label mb-1">Cliente</div>
        <h2 class="fw-bold mb-2" style="font-size:1.75rem;color:#1a3a5c;line-height:1.2">@Model.RazonSocial</h2>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="sg-rut-chip">@Model.Rut</span>
            @if (esActivo)
            {
                <span class="sg-badge-activo"><span class="sg-badge-dot"></span>Activo</span>
            }
            else
            {
                <span class="sg-badge-inactivo"><span class="sg-badge-dot"></span>Inactivo</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-start">
        @if (esAuxiliar)
        {
            <button type="button" class="btn sg-btn-primary-dark"
                    data-bs-toggle="modal" data-bs-target="#modal-sin-permiso"
                    style="opacity:.55;">
                <i class="ti ti-lock me-1"></i>Editar cliente
            </button>
            <button type="button" class="btn btn-outline-danger"
                    data-bs-toggle="modal" data-bs-target="#modal-sin-permiso"
                    style="opacity:.55;">
                <i class="ti ti-lock me-1"></i>@(esActivo ? "Desactivar" : "Activar")
            </button>
        }
        else
        {
            <a asp-action="Editar" asp-controller="Clientes" asp-route-id="@Model.Id" class="btn sg-btn-primary-dark">
                <i class="ti ti-edit me-1"></i>Editar cliente
            </a>
            @if (esActivo)
            {
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modal-desactivar">
                    <i class="ti ti-ban me-1"></i>Desactivar
                </button>
            }
            else
            {
                <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modal-activar">
                    <i class="ti ti-circle-check me-1"></i>Activar
                </button>
            }
        }
        <a id="btn-volver" asp-action="Index" asp-controller="Clientes" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<!-- ── Tab content ────────────────────────────────────────────────── -->
<div id="clienteTabsContent">

    <!-- Resumen ───────────────────────────────────── -->
    <div class="tab-pane fade" id="tab-resumen">
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <div class="card h-100" data-aos="fade-up" data-aos-delay="0">
                    <div class="card-header">
                        <h3 class="card-title"><i class="ti ti-info-circle me-1 text-azure"></i>Información General</h3>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="sg-detail-label">RUT</div>
                                <div class="sg-detail-value"><span class="sg-rut-chip">@Model.Rut</span></div>
                            </div>
                            <div class="col-12">
                                <div class="sg-detail-label">Razón Social</div>
                                <div class="sg-detail-value">@Model.RazonSocial</div>
                            </div>
                            <div class="col-12">
                                <div class="sg-detail-label">Nombre Fantasía</div>
                                <div class="sg-detail-value">@(string.IsNullOrWhiteSpace(Model.NombreFantasia) ? "No informado" : Model.NombreFantasia)</div>
                            </div>
                            <div class="col-12">
                                <div class="sg-detail-label">Tipo de Contribuyente</div>
                                <div class="sg-detail-value">@Model.TipoContribuyente</div>
                            </div>
                            <div class="col-12">
                                <div class="sg-detail-label">Estado</div>
                                @if (esActivo)
                                {
                                    <span class="sg-badge-activo"><span class="sg-badge-dot"></span>Activo</span>
                                }
                                else
                                {
                                    <span class="sg-badge-inactivo"><span class="sg-badge-dot"></span>Inactivo</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="card h-100" data-aos="fade-up" data-aos-delay="75">
                    <div class="card-header">
                        <h3 class="card-title"><i class="ti ti-address-book me-1 text-azure"></i>Contacto</h3>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="sg-detail-label">Email</div>
                                <div class="sg-detail-value">@Model.Email</div>
                            </div>
                            <div class="col-12">
                                <div class="sg-detail-label">Teléfono</div>
                                <div class="sg-detail-value">@Model.Telefono</div>
                            </div>
                            <div class="col-12">
                                <div class="sg-detail-label">Dirección</div>
                                <div class="sg-detail-value">@(string.IsNullOrWhiteSpace(Model.Direccion) ? "No informado" : Model.Direccion)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12" data-aos="fade-up" data-aos-delay="150">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="ti ti-settings me-1 text-azure"></i>Configuración</h3>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <div class="sg-detail-label">Moneda Base</div>
                                <div class="sg-detail-value">@Model.MonedaBase</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contabilidad ──────────────────────────────── -->
    <div class="tab-pane fade" id="tab-contabilidad">
        <div class="row g-3 row-cols-1 row-cols-sm-2">
            <div class="col" data-aos="fade-up" data-aos-delay="0">
                <div class="card h-100 sg-action-card">
                    <div class="card-body d-flex flex-column">
                        <div class="sg-action-icon mb-3"><i class="ti ti-book"></i></div>
                        <h4 class="card-title fw-semibold mb-1">Libro Diario</h4>
                        <p class="text-muted mb-3" style="font-size:13px">Registro cronológico de todos los asientos contables del cliente.</p>
                        <div class="mt-auto">
                            <a asp-action="Index" asp-controller="AsientosContables" asp-route-clienteId="@Model.Id" class="btn btn-sm sg-btn-primary-dark">
                                <i class="ti ti-arrow-right me-1"></i>Ver Libro Diario
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col" data-aos="fade-up" data-aos-delay="75">
                <div class="card h-100 sg-action-card">
                    <div class="card-body d-flex flex-column">
                        <div class="sg-action-icon mb-3"><i class="ti ti-books"></i></div>
                        <h4 class="card-title fw-semibold mb-1">Libro Mayor</h4>
                        <p class="text-muted mb-3" style="font-size:13px">Agrupación de movimientos por cuenta contable con saldos acumulados.</p>
                        <div class="mt-auto">
                            @if (esAuxiliar)
                            {
                                <button type="button" class="btn btn-sm sg-btn-primary-dark"
                                        data-bs-toggle="modal" data-bs-target="#modal-sin-permiso"
                                        style="opacity:.55;">
                                    <i class="ti ti-lock me-1"></i>Ver Libro Mayor
                                </button>
                            }
                            else
                            {
                                <a asp-action="Index" asp-controller="LibroMayor" asp-route-clienteId="@Model.Id" class="btn btn-sm sg-btn-primary-dark">
                                    <i class="ti ti-arrow-right me-1"></i>Ver Libro Mayor
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col" data-aos="fade-up" data-aos-delay="150">
                <div class="card h-100 sg-action-card">
                    <div class="card-body d-flex flex-column">
                        <div class="sg-action-icon mb-3"><i class="ti ti-chart-bar"></i></div>
                        <h4 class="card-title fw-semibold mb-1">Estado de Resultados</h4>
                        <p class="text-muted mb-3" style="font-size:13px">Resumen de ingresos, gastos y resultado del ejercicio contable.</p>
                        <div class="mt-auto">
                            @if (esAuxiliar)
                            {
                                <button type="button" class="btn btn-sm sg-btn-primary-dark"
                                        data-bs-toggle="modal" data-bs-target="#modal-sin-permiso"
                                        style="opacity:.55;">
                                    <i class="ti ti-lock me-1"></i>Ver Estado de Resultados
                                </button>
                            }
                            else
                            {
                                <a asp-action="Index" asp-controller="EstadoResultados" asp-route-clienteId="@Model.Id" class="btn btn-sm sg-btn-primary-dark">
                                    <i class="ti ti-arrow-right me-1"></i>Ver Estado de Resultados
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col" data-aos="fade-up" data-aos-delay="225">
                <div class="card h-100 sg-action-card">
                    <div class="card-body d-flex flex-column">
                        <div class="sg-action-icon mb-3"><i class="ti ti-scale"></i></div>
                        <h4 class="card-title fw-semibold mb-1">Balance General</h4>
                        <p class="text-muted mb-3" style="font-size:13px">Activos, pasivos y patrimonio del cliente en un período determinado.</p>
                        <div class="mt-auto">
                            @if (esAuxiliar)
                            {
                                <button type="button" class="btn btn-sm sg-btn-primary-dark"
                                        data-bs-toggle="modal" data-bs-target="#modal-sin-permiso"
                                        style="opacity:.55;">
                                    <i class="ti ti-lock me-1"></i>Ver Balance General
                                </button>
                            }
                            else
                            {
                                <a asp-action="Index" asp-controller="BalanceGeneral" asp-route-clienteId="@Model.Id" class="btn btn-sm sg-btn-primary-dark">
                                    <i class="ti ti-arrow-right me-1"></i>Ver Balance General
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col" data-aos="fade-up" data-aos-delay="300">
                <div class="card h-100 sg-action-card">
                    <div class="card-body d-flex flex-column">
                        <div class="sg-action-icon mb-3"><i class="ti ti-calendar-x"></i></div>
                        <h4 class="card-title fw-semibold mb-1">Cierre de Ejercicio</h4>
                        <p class="text-muted mb-3" style="font-size:13px">Salda las cuentas de ingresos y egresos y transfiere el resultado al patrimonio.</p>
                        <div class="mt-auto">
                            @if (esAuxiliar)
                            {
                                <button type="button" class="btn btn-sm sg-btn-primary-dark"
                                        data-bs-toggle="modal" data-bs-target="#modal-sin-permiso"
                                        style="opacity:.55;">
                                    <i class="ti ti-lock me-1"></i>Cierre de Ejercicio
                                </button>
                            }
                            else
                            {
                                <a asp-action="CierreEjercicio" asp-controller="Ejercicios" asp-route-clienteId="@Model.Id" class="btn btn-sm sg-btn-primary-dark">
                                    <i class="ti ti-arrow-right me-1"></i>Cierre de Ejercicio
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fiscal ────────────────────────────────────── -->
    <div class="tab-pane fade" id="tab-fiscal">
        <div class="row g-3 row-cols-1 row-cols-sm-2">
            <div class="col" data-aos="fade-up" data-aos-delay="0">
                <div class="card h-100 sg-action-card sg-card-fiscal">
                    <div class="card-body d-flex flex-column">
                        <div class="sg-action-icon sg-icon-fiscal mb-3"><i class="ti ti-receipt-tax"></i></div>
                        <h4 class="card-title fw-semibold mb-1">IVA</h4>
                        <p class="text-muted mb-3" style="font-size:13px">Liquidación y gestión del Impuesto al Valor Agregado del cliente.</p>
                        <div class="mt-auto">
                            @if (esAuxiliar)
                            {
                                <button class="btn btn-sm sg-btn-primary-dark" disabled
                                        title="No disponible para auxiliares contables"
                                        style="opacity:.5;cursor:not-allowed;">
                                    <i class="ti ti-lock me-1"></i>Ver IVA
                                </button>
                            }
                            else
                            {
                                <a asp-action="Index" asp-controller="LiquidacionIva" asp-route-clienteId="@Model.Id" class="btn btn-sm sg-btn-primary-dark">
                                    <i class="ti ti-arrow-right me-1"></i>Ver IVA
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col" data-aos="fade-up" data-aos-delay="75">
                <div class="card h-100 sg-action-card sg-card-fiscal">
                    <div class="card-body d-flex flex-column">
                        <div class="sg-action-icon sg-icon-fiscal mb-3"><i class="ti ti-file-invoice"></i></div>
                        <h4 class="card-title fw-semibold mb-1">Comprobantes</h4>
                        <p class="text-muted mb-3" style="font-size:13px">Gestión de comprobantes fiscales y documentos de respaldo.</p>
                        <div class="mt-auto">
                            <a asp-action="Index" asp-controller="Comprobantes" asp-route-clienteId="@Model.Id" class="btn btn-sm sg-btn-primary-dark">
                                <i class="ti ti-arrow-right me-1"></i>Ver Comprobantes
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Plan de Cuentas ───────────────────────────── -->
    <div class="tab-pane fade" id="tab-plan">
        <div class="row g-3">
            <div class="col-12 col-md-6" data-aos="fade-up">
                <div class="card sg-action-card">
                    <div class="card-body d-flex flex-column">
                        <div class="sg-action-icon mb-3"><i class="ti ti-list-tree"></i></div>
                        <h4 class="card-title fw-semibold mb-1">Plan de Cuentas</h4>
                        <p class="text-muted mb-3" style="font-size:13px">Estructura jerárquica de cuentas contables asignada a este cliente.</p>
                        <div class="mt-auto">
                            <a asp-action="PlanDeCuentas" asp-controller="Clientes" asp-route-id="@Model.Id" class="btn btn-sm sg-btn-primary-dark">
                                <i class="ti ti-arrow-right me-1"></i>Ver Plan de Cuentas
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ejercicios Contables ──────────────────────── -->
    <div class="tab-pane fade" id="tab-ejercicios">
        <div class="row g-3">
            <div class="col-12 col-md-6" data-aos="fade-up">
                <div class="card sg-action-card">
                    <div class="card-body d-flex flex-column">
                        <div class="sg-action-icon mb-3"><i class="ti ti-calendar-stats"></i></div>
                        <h4 class="card-title fw-semibold mb-1">Ejercicios Contables</h4>
                        <p class="text-muted mb-3" style="font-size:13px">Períodos contables del cliente con sus respectivos estados y cierres.</p>
                        <div class="mt-auto">
                            <a asp-action="Index" asp-controller="Ejercicios" asp-route-clienteId="@Model.Id" class="btn btn-sm sg-btn-primary-dark">
                                <i class="ti ti-arrow-right me-1"></i>Ver Ejercicios Contables
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- ── Modal: Desactivar ──────────────────────────────────────────── -->
@if (esActivo)
{
    <div class="modal modal-blur fade" id="modal-desactivar" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar desactivación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body text-secondary">
                    ¿Deseas desactivar el cliente <strong>@Model.RazonSocial</strong>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-action="Desactivar" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Desactivar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Modal: Activar ─────────────────────────────────────────────── -->
@if (!esActivo)
{
    <div class="modal modal-blur fade" id="modal-activar" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar activación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body text-secondary">
                    ¿Deseas activar el cliente <strong>@Model.RazonSocial</strong>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-action="Activar" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success">Activar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var tabPanes = document.querySelectorAll('#clienteTabsContent .tab-pane');
            var btnVolver = document.getElementById('btn-volver');
            var skipNextHashChange = false;

            function showTab(targetId, updateUrl) {
                tabPanes.forEach(function (pane) {
                    pane.classList.remove('show', 'active');
                });
                var target = document.querySelector(targetId);
                if (target) {
                    target.classList.add('show', 'active');
                }
                if (updateUrl !== false) {
                    skipNextHashChange = false;
                    window.location.hash = targetId;
                } else {
                    skipNextHashChange = true;
                }
                updateVolverButton(targetId);
            }

            function updateVolverButton(currentTab) {
                if (!btnVolver) return;

                // Si estamos en la pestaña Resumen, volver al index de clientes
                if (currentTab === '#tab-resumen') {
                    btnVolver.onclick = null;
                } else {
                    // Si estamos en cualquier otra pestaña, volver a Resumen
                    btnVolver.onclick = function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        // Cambiar pestaña directamente sin tocar el hash
                        tabPanes.forEach(function (pane) {
                            pane.classList.remove('show', 'active');
                        });
                        var resumeTab = document.querySelector('#tab-resumen');
                        if (resumeTab) {
                            resumeTab.classList.add('show', 'active');
                        }
                        updateVolverButton('#tab-resumen');
                        return false;
                    };
                }
            }

            window.addEventListener('hashchange', function () {
                if (skipNextHashChange) {
                    skipNextHashChange = false;
                    return;
                }
                showTab(window.location.hash || '#tab-resumen');
            });

            showTab(window.location.hash || '#tab-resumen');
        });
    </script>
}
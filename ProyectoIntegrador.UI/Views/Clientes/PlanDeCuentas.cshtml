@model List<CuentaContableArbolViewModel>
@{
    ViewData["Title"] = "Plan de cuentas";

    IEnumerable<CuentaContableArbolViewModel> Flatten(IEnumerable<CuentaContableArbolViewModel> items)
    {
        foreach (var item in items)
        {
            yield return item;
            foreach (var child in Flatten(item.Hijas))
                yield return child;
        }
    }
    var todas      = Flatten(Model).ToList();
    var total      = todas.Count;
    var imputables = todas.Count(c => c.EsImputable);
    var noImput    = todas.Count(c => !c.EsImputable);
    var inactivas  = todas.Count(c => c.Estado == "Inactiva");
}

<style>
    .sg-stat-card {
        border-top-width: 3px !important;
        border-top-style: solid !important;
    }

    .input-icon .input-icon-addon {
        pointer-events: none;
    }

    .list-group-hoverable .list-group-item {
        transition: background-color 0.12s ease;
    }
</style>

@* PAGE HEADER *@
<div class="d-flex justify-content-between align-items-center mb-3" data-aos="fade-down">
    <div>
        <div style="font-size:20px;font-weight:600;color:#1a3a5c;">
            <i class="ti ti-list-tree me-1"></i>Plan de cuentas
        </div>
        <div class="text-muted" style="font-size:13px;">
            Detalle del plan de cuentas de @ViewData["ClienteNombre"]
        </div>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-azure">
        <i class="ti ti-arrow-left"></i> Volver
    </a>
</div>

@* STAT CARDS ROW *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="0">
        <div class="card sg-stat-card" style="border-top-color:#1a3a5c;">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar rounded" style="background-color:#1a3a5c20;color:#1a3a5c;">
                        <i class="ti ti-list-tree"></i>
                    </span>
                    <div>
                        <div class="text-muted" style="font-size:12px;">Total cuentas</div>
                        <div style="font-size:22px;font-weight:700;color:#1a3a5c;">@total</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="100">
        <div class="card sg-stat-card" style="border-top-color:#2fb344;">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar rounded" style="background-color:#2fb34420;color:#2fb344;">
                        <i class="ti ti-circle-check"></i>
                    </span>
                    <div>
                        <div class="text-muted" style="font-size:12px;">Imputables</div>
                        <div style="font-size:22px;font-weight:700;color:#2fb344;">@imputables</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="200">
        <div class="card sg-stat-card" style="border-top-color:#f59f00;">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar rounded" style="background-color:#f59f0020;color:#f59f00;">
                        <i class="ti ti-ban"></i>
                    </span>
                    <div>
                        <div class="text-muted" style="font-size:12px;">No imputables</div>
                        <div style="font-size:22px;font-weight:700;color:#f59f00;">@noImput</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="300">
        <div class="card sg-stat-card" style="border-top-color:#d63939;">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar rounded" style="background-color:#d6393920;color:#d63939;">
                        <i class="ti ti-circle-x"></i>
                    </span>
                    <div>
                        <div class="text-muted" style="font-size:12px;">Inactivas</div>
                        <div style="font-size:22px;font-weight:700;color:#d63939;">@inactivas</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* TREE CARD *@
<div class="card shadow-sm" style="border-top:3px solid #1a3a5c;" data-aos="fade-up" data-aos-delay="100">
    <div class="card-header flex-wrap gap-2">
        <div>
            <div class="card-title">Árbol de cuentas</div>
            <div class="text-secondary" style="font-size:13px;">Estructura jerárquica completa del plan de cuentas.</div>
        </div>
        <div class="d-flex align-items-center gap-2 ms-auto">
            @* Search — requires _CuentaContableFila rows to have class="sg-cuenta-fila" data-codigo="..." data-nombre="..." *@
            <div class="input-icon" style="max-width:240px;">
                <span class="input-icon-addon">
                    <i class="ti ti-search"></i>
                </span>
                <input type="text" id="buscar-cuentas" class="form-control form-control-sm" placeholder="Buscar cuenta...">
            </div>
            @* Expand/collapse — requires _CuentaContableFila children container class="sg-cuenta-hijos" and toggle icon class="sg-toggle-icon" *@
            <button id="btn-expandir-todo" class="btn btn-sm btn-outline-secondary" title="Expandir todo">
                <i class="ti ti-chevrons-down"></i>
            </button>
            <button id="btn-colapsar-todo" class="btn btn-sm btn-outline-secondary" title="Colapsar todo">
                <i class="ti ti-chevrons-up"></i>
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="p-4">
                <div class="empty">
                    <div class="empty-img">
                        <i class="ti ti-folder-off fs-1 text-secondary"></i>
                    </div>
                    <p class="empty-title">No hay cuentas registradas</p>
                    <p class="empty-subtitle text-secondary">Todavía no se cargaron cuentas para este cliente.</p>
                </div>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush list-group-hoverable">
                @foreach (var cuenta in Model)
                {
                    @await Html.PartialAsync("_CuentaContableFila", cuenta, new ViewDataDictionary(ViewData) { ["Nivel"] = 0 })
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Búsqueda — ahora funciona porque _CuentaContableFila tiene .sg-cuenta-fila + data-codigo/data-nombre
        (function () {
            var input = document.getElementById('buscar-cuentas');
            if (!input) return;

            input.addEventListener('input', function () {
                var q = input.value.toLowerCase().trim();

                // Sin búsqueda: mostrar todo y colapsar
                if (!q) {
                    document.querySelectorAll('.sg-cuenta-fila').forEach(function (el) {
                        el.style.display = '';
                    });
                    document.querySelectorAll('.tree-node').forEach(function (el) {
                        el.removeAttribute('open');
                    });
                    return;
                }

                // Primero ocultar todo
                document.querySelectorAll('.sg-cuenta-fila').forEach(function (el) {
                    el.style.display = 'none';
                });

                // Encontrar matches y mostrarlos junto con todos sus ancestros
                document.querySelectorAll('.sg-cuenta-fila').forEach(function (el) {
                    var codigo = (el.getAttribute('data-codigo') || '').toLowerCase();
                    var nombre = (el.getAttribute('data-nombre') || '').toLowerCase();

                    if (codigo.includes(q) || nombre.includes(q)) {
                        // Mostrar el elemento
                        el.style.display = '';

                        // Mostrar y abrir todos los ancestros
                        var parent = el.parentElement;
                        while (parent) {
                            if (parent.classList.contains('sg-cuenta-fila')) {
                                parent.style.display = '';
                            }
                            if (parent.tagName === 'DETAILS' && parent.classList.contains('tree-node')) {
                                parent.setAttribute('open', '');
                            }
                            parent = parent.parentElement;
                        }
                    }
                });
            });
        })();

        // Expandir/colapsar todo — funciona porque .sg-cuenta-hijos y .sg-toggle-icon están en el partial
        (function () {
            var btnExp = document.getElementById('btn-expandir-todo');
            var btnCol = document.getElementById('btn-colapsar-todo');
            if (!btnExp || !btnCol) return;

            btnExp.addEventListener('click', function () {
                document.querySelectorAll('.tree-node').forEach(function (el) {
                    el.setAttribute('open', '');
                });
            });

            btnCol.addEventListener('click', function () {
                document.querySelectorAll('.tree-node').forEach(function (el) {
                    el.removeAttribute('open');
                });
            });
        })();

        // Rotar caret del <details> con CSS via JS al abrir/cerrar
        document.addEventListener('toggle', function (e) {
            if (!e.target.classList.contains('tree-node')) return;
            var icon = e.target.querySelector(':scope > summary .sg-toggle-icon');
            if (!icon) return;
            if (e.target.open) {
                icon.classList.remove('ti-chevron-right');
                icon.classList.add('ti-chevron-down');
            } else {
                icon.classList.remove('ti-chevron-down');
                icon.classList.add('ti-chevron-right');
            }
        }, true);
    </script>
}
@model List<CuentaContableArbolViewModel>
@{
    ViewData["Title"] = "Plan de cuentas";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">Plan de cuentas</h2>
                <div class="text-secondary">Detalle del plan de cuentas de @ViewData["ClienteNombre"]</div>
            </div>
            <div class="col-auto ms-auto">
                <a asp-action="Index" class="btn btn-outline-azure">
                    <i class="ti ti-arrow-left"></i> Volver
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card shadow-sm">
            <div class="card-status-start bg-azure"></div>
            <div class="card-header">
                <div>
                    <div class="card-title">Árbol de cuentas</div>
                    <div class="text-secondary">Estructura jerárquica completa del plan de cuentas.</div>
                </div>
                <div class="card-actions">
                    <span class="badge bg-azure-lt text-azure">Total: @Model.Count</span>
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model.Count == 0)
                {
                    <div class="p-4">
                        <div class="empty">
                            <div class="empty-img">
                                <i class="ti ti-folder-off fs-1 text-secondary"></i>
                            </div>
                            <p class="empty-title">No hay cuentas registradas</p>
                            <p class="empty-subtitle text-secondary">Todavía no se cargaron cuentas para este cliente.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush list-group-hoverable">
                        @foreach (var cuenta in Model)
                        {
                            @await Html.PartialAsync("_CuentaContableFila", cuenta, new ViewDataDictionary(ViewData) { ["Nivel"] = 0 })
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@model CuentaContableArbolViewModel
@{
    var nivel = ViewData["Nivel"] as int? ?? 0;
    var paddingLeft = nivel * 24;
    var tieneHijas = Model.Hijas?.Count > 0;
    var estadoClase = Model.Estado == "Activa" ? "bg-green-lt text-green" : "bg-red-lt text-red";
    var imputableClase = Model.EsImputable ? "bg-green-lt text-green" : "bg-yellow-lt text-yellow";
}

<div class="list-group-item">
    <div class="d-flex align-items-start gap-3" style="padding-left: @(paddingLeft)px;">
        @if (tieneHijas)
        {
            <details class="w-100 tree-node">
                <summary class="d-flex align-items-center gap-3 cursor-pointer">
                    <span class="text-secondary"><i class="ti ti-chevron-right tree-caret"></i></span>
                    <span class="avatar avatar-sm bg-azure-lt text-azure">
                        <i class="ti ti-folder"></i>
                    </span>
                    <span class="flex-fill">
                        <span class="d-flex align-items-center justify-content-between gap-3">
                            <a asp-controller="CuentasContables" asp-action="Details" asp-route-id="@Model.Id" class="fw-semibold text-dark text-decoration-none">
                                @Model.Nombre
                            </a>
                            <span class="d-flex align-items-center gap-2">
                                <span class="badge bg-azure-lt text-azure">@Model.Codigo</span>
                                <span class="badge @estadoClase">@Model.Estado</span>
                                <span class="badge @imputableClase">@(Model.EsImputable ? "Imputable" : "No imputable")</span>
                            </span>
                        </span>
                        <span class="text-secondary small">Cuenta con subniveles</span>
                    </span>
                </summary>
                <div class="mt-3 tree-children">
                    <div class="list-group list-group-flush">
                        @foreach (var hija in Model.Hijas)
                        {
                            @await Html.PartialAsync("_CuentaContableFila", hija, new ViewDataDictionary(ViewData) { ["Nivel"] = nivel + 1 })
                        }
                    </div>
                </div>
            </details>
        }
        else
        {
            <a asp-controller="CuentasContables" asp-action="Details" asp-route-id="@Model.Id" class="d-flex align-items-center gap-3 w-100 text-decoration-none">
                <span class="text-secondary"><i class="ti ti-file"></i></span>
                <div class="flex-fill">
                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <div class="fw-semibold text-dark">@Model.Nombre</div>
                        <span class="d-flex align-items-center gap-2">
                            <span class="badge bg-muted-lt text-muted">@Model.Codigo</span>
                            <span class="badge @estadoClase">@Model.Estado</span>
                            <span class="badge @imputableClase">@(Model.EsImputable ? "Imputable" : "No imputable")</span>
                        </span>
                    </div>
                    <div class="text-secondary small">Cuenta auxiliar</div>
                </div>
            </a>
        }
    </div>
</div>

@model ClienteViewModel
@{
    ViewData["Title"] = "Nuevo Cliente";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body p-4">
                <h3 class="card-title mb-4">
                    <i class="ti ti-plus"></i> Nuevo Cliente
                </h3>

                @if (!ViewContext.ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                }

                <form asp-action="Crear" method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Rut" class="form-label"></label>
                            <input asp-for="Rut" class="form-control" placeholder="219999870015" />
                            <span asp-validation-for="Rut" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="RazonSocial" class="form-label"></label>
                            <input asp-for="RazonSocial" class="form-control" />
                            <span asp-validation-for="RazonSocial" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="NombreFantasia" class="form-label"></label>
                            <input asp-for="NombreFantasia" class="form-control" placeholder="(opcional)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="empresa@ejemplo.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Telefono" class="form-label"></label>
                            <input asp-for="Telefono" class="form-control" placeholder="099123456" />
                            <span asp-validation-for="Telefono" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Direccion" class="form-label"></label>
                            <input asp-for="Direccion" class="form-control" placeholder="Av. 18 de Julio 1234" />
                            <span asp-validation-for="Direccion" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TipoContribuyente" class="form-label"></label>
                            <select asp-for="TipoContribuyente" class="form-select">
                                <option value="">-- Seleccionar --</option>
                                <option value="CEDE">CEDE</option>
                                <option value="ResponsableIVA">Responsable IVA</option>
                                <option value="Monotributo">Monotributo</option>
                                <option value="LiteralE">Literal E</option>
                                <option value="NoAlcanzado">No Alcanzado</option>
                                <option value="Exento">Exento</option>
                            </select>
                            <span asp-validation-for="TipoContribuyente" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MonedaBase" class="form-label"></label>
                            <select asp-for="MonedaBase" class="form-select">
                                <option value="">-- Seleccionar --</option>
                                <option value="UYU">UYU (Peso Uruguayo)</option>
                                <option value="USD">USD (Dólar Estadounidense)</option>
                            </select>
                            <span asp-validation-for="MonedaBase" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn sg-btn-primary-dark">
                            <i class="ti ti-check me-1"></i>Guardar
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="ti ti-x me-1"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

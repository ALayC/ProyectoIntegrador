@model UsuarioIndexViewModel
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3" data-aos="fade-down">
    <h2><i class="ti ti-users"></i> Gestión de Usuarios</h2>
    <div class="d-flex gap-2">
        <a asp-controller="Roles" asp-action="Index" class="btn btn-outline-azure">
            <i class="ti ti-shield"></i> Gestionar Roles
        </a>
        <a asp-action="Crear" class="btn btn-azure">
            <i class="ti ti-plus"></i> Nuevo Usuario
        </a>
    </div>
</div>

@* Filtros *@
<form method="get" asp-action="Index" class="row g-2 mb-3" data-aos="fade-up">
    <div class="col-md-3">
        <select name="filtroRol" class="form-select">
            <option value="">Todos los roles</option>
            <option value="Administrador" selected="@(Model.FiltroRol == "Administrador")">Administrador</option>
            <option value="Contador" selected="@(Model.FiltroRol == "Contador")">Contador</option>
            <option value="Auxiliar Contable" selected="@(Model.FiltroRol == "Auxiliar Contable")">Auxiliar Contable</option>
        </select>
    </div>
    <div class="col-md-3">
        <select name="filtroEstado" class="form-select">
            <option value="">Todos los estados</option>
            <option value="Activo" selected="@(Model.FiltroEstado == "Activo")">Activo</option>
            <option value="Inactivo" selected="@(Model.FiltroEstado == "Inactivo")">Inactivo</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-azure">
            <i class="ti ti-filter"></i> Filtrar
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-1">
            <i class="ti ti-x"></i> Limpiar
        </a>
    </div>
</form>

@if (Model.Usuarios.Count == 0)
{
    <div class="alert alert-info">
        <i class="ti ti-info-circle"></i> No hay usuarios que coincidan con los filtros seleccionados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model.Usuarios)
                {
                    var esInactivo = usuario.Estado == "Inactivo";
                    <tr class="@(esInactivo ? "text-muted" : "")">
                        <td>@usuario.NombreCompleto</td>
                        <td>@usuario.Email</td>
                        <td>
                            <span class="badge bg-azure-lt text-azure">@usuario.Rol</span>
                        </td>
                        <td>
                            @if (esInactivo)
                            {
                                <span class="badge bg-danger-lt text-danger">Inactivo</span>
                            }
                            else
                            {
                                <span class="badge bg-success-lt text-success">Activo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Editar" asp-route-id="@usuario.Id"
                                   class="btn btn-sm btn-outline-azure" title="Editar">
                                <i class="ti ti-edit"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Paginación de usuarios">
            <ul class="pagination justify-content-center">
                <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-pagina="@(Model.Pagina - 1)"
                       asp-route-cantidadPorPagina="@Model.CantidadPorPagina"
                       asp-route-filtroRol="@Model.FiltroRol"
                       asp-route-filtroEstado="@Model.FiltroEstado">&laquo; Anterior</a>
                </li>
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.Pagina ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-pagina="@i"
                           asp-route-cantidadPorPagina="@Model.CantidadPorPagina"
                           asp-route-filtroRol="@Model.FiltroRol"
                           asp-route-filtroEstado="@Model.FiltroEstado">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-pagina="@(Model.Pagina + 1)"
                       asp-route-cantidadPorPagina="@Model.CantidadPorPagina"
                       asp-route-filtroRol="@Model.FiltroRol"
                       asp-route-filtroEstado="@Model.FiltroEstado">Siguiente &raquo;</a>
                </li>
            </ul>
        </nav>
        <p class="text-center text-muted">
            Mostrando página @Model.Pagina de @Model.TotalPaginas (@Model.TotalRegistros registros en total)
        </p>
    }
}

@model ComprobanteDetalleViewModel
@{
    ViewData["Title"] = "Detalle de Comprobante";
    var clienteId = (Guid)ViewBag.ClienteId;
    var clienteNombre = (string)ViewBag.ClienteNombre;
    var ejercicios = ViewBag.Ejercicios as List<EjercicioContableViewModel> ?? new List<EjercicioContableViewModel>();
    var cuentas = ViewBag.CuentasImputables as List<CuentaContableViewModel> ?? new List<CuentaContableViewModel>();
    var bloqueadoPorAsiento = Model.TieneAsiento;
    var bloqueadoPorEstado = Model.EstaAnulado;
}

<div class="alert alert-info mb-3" role="alert">
    <div class="d-flex">
        <div><i class="ti ti-info-circle me-2"></i></div>
        <div>
            <strong>Importante:</strong> actualmente la generación automática de asientos desde comprobantes funciona solo en moneda nacional (<strong>UYU</strong>) con tipo de cambio <strong>1.00</strong>. La modalidad multi-moneda se incorporará en una fase posterior.
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1"><i class="ti ti-receipt"></i> Comprobante @Model.Numero</h2>
        <div class="text-secondary">@clienteNombre</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" asp-route-clienteId="@clienteId" class="btn btn-outline-azure">
            <i class="ti ti-arrow-left"></i> Volver
        </a>
        @if (!bloqueadoPorAsiento && !bloqueadoPorEstado)
        {
            <a asp-action="Editar" asp-route-id="@Model.Id" asp-route-clienteId="@clienteId" class="btn btn-azure">
                <i class="ti ti-edit"></i> Editar
            </a>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmar-anular">
                <i class="ti ti-ban"></i> Anular
            </button>
        }
        else
        {
            <button type="button" class="btn btn-outline-secondary" disabled>
                <i class="ti ti-lock"></i> Edición bloqueada
            </button>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Datos del comprobante</h3>
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-6">
                        <div class="text-secondary">Tipo</div>
                        <div class="fw-semibold">@Model.Tipo</div>
                    </div>
                    <div class="col-6">
                        <div class="text-secondary">Número</div>
                        <div class="fw-semibold">@Model.Numero</div>
                    </div>
                    <div class="col-6">
                        <div class="text-secondary">RUT</div>
                        <div class="fw-semibold">@Model.RUT</div>
                    </div>
                    <div class="col-6">
                        <div class="text-secondary">Fecha</div>
                        <div class="fw-semibold">@Model.Fecha.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="col-6">
                        <div class="text-secondary">Estado</div>
                        @if (Model.EstaAnulado)
                        {
                            <span class="badge bg-danger-lt text-danger">Anulado</span>
                        }
                        else
                        {
                            <span class="badge bg-success-lt text-success">Activo</span>
                        }
                    </div>
                    <div class="col-6">
                        <div class="text-secondary">Asiento asociado</div>
                        @if (Model.TieneAsiento)
                        {
                            <a asp-controller="AsientosContables" asp-action="Detalles" asp-route-id="@Model.AsientoId" asp-route-clienteId="@clienteId" class="btn btn-sm btn-azure">
                                <i class="ti ti-eye"></i> Ver
                            </a>
                        }
                        else
                        {
                            <div class="text-secondary">Sin asiento</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Importes</h3>
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-6">
                        <div class="text-secondary">Importe neto</div>
                        <div class="fw-semibold">@Model.ImporteNeto.ToString("N2")</div>
                    </div>
                    <div class="col-6">
                        <div class="text-secondary">Tasa IVA</div>
                        <div class="fw-semibold">@Model.TasaIVA.ToString("N2")%</div>
                    </div>
                    <div class="col-6">
                        <div class="text-secondary">Importe IVA</div>
                        <div class="fw-semibold">@Model.ImporteIVA.ToString("N2")</div>
                    </div>
                    <div class="col-6">
                        <div class="text-secondary">Importe total</div>
                        <div class="fw-bold text-azure">@Model.ImporteTotal.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Acciones</h3>
            </div>
            <div class="card-body d-flex flex-wrap gap-2">
                @if (!bloqueadoPorAsiento && !bloqueadoPorEstado)
                {
                    <button type="button" class="btn btn-outline-azure" data-bs-toggle="modal" data-bs-target="#generar-asiento">
                        <i class="ti ti-file-plus"></i> Generar asiento
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-outline-secondary" disabled>
                        <i class="ti ti-file-plus"></i> Generar asiento
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@if (!bloqueadoPorAsiento && !bloqueadoPorEstado)
{
    <div class="modal modal-blur fade" id="generar-asiento" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Generar asiento desde comprobante</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form asp-action="GenerarAsiento" asp-route-id="@Model.Id" asp-route-clienteId="@clienteId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="alert alert-info" role="alert">
                            Este proceso generará líneas de asiento en <strong>UYU</strong> (moneda nacional) con tipo de cambio <strong>1.00</strong>.
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Ejercicio contable</label>
                                <select name="EjercicioId" class="form-select" required>
                                    <option value="">Seleccionar...</option>
                                    @foreach (var ej in ejercicios)
                                    {
                                        <option value="@ej.Id">@ej.FechaInicio.Year - @ej.FechaFin.Year (@ej.Estado)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Fecha</label>
                                <input type="date" name="Fecha" class="form-control" value="@Model.Fecha.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Cuenta Debe</label>
                                <select name="CuentaDebeId" class="form-select" required>
                                    <option value="">Seleccionar...</option>
                                    @foreach (var cuenta in cuentas)
                                    {
                                        <option value="@cuenta.Id">@cuenta.Codigo - @cuenta.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Cuenta Haber</label>
                                <select name="CuentaHaberId" class="form-select" required>
                                    <option value="">Seleccionar...</option>
                                    @foreach (var cuenta in cuentas)
                                    {
                                        <option value="@cuenta.Id">@cuenta.Codigo - @cuenta.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Glosa (opcional)</label>
                                <input type="text" name="Glosa" class="form-control" placeholder="Asiento generado desde comprobante" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-azure" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-azure">Generar asiento</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (!bloqueadoPorAsiento && !bloqueadoPorEstado)
{
    <div class="modal modal-blur fade" id="confirmar-anular" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar anulación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body text-secondary">
                    ¿Deseas anular el comprobante <strong>@Model.Numero</strong>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-azure" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-action="Anular" asp-route-id="@Model.Id" asp-route-clienteId="@clienteId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Anular</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

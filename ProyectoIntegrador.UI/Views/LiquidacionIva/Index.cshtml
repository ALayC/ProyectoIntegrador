@model LiquidacionIvaViewModel
@{
    ViewData["Title"] = "Liquidación de IVA";
    ViewData["ClienteId"] = Model.ClienteId;
    ViewData["ClienteNombre"] = Model.ClienteNombre;
    var meses = new[]
    {
        "Enero","Febrero","Marzo","Abril","Mayo","Junio",
        "Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"
    };
    var anioActual = DateTime.Today.Year;
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <i class="ti ti-cash"></i> Liquidación de IVA
                </h2>
                @if (!string.IsNullOrWhiteSpace(Model.ClienteNombre))
                {
                    <div class="text-secondary">@Model.ClienteNombre</div>
                }
            </div>
            <div class="col-auto ms-auto">
                <a href="@Url.Action("Detalles", "Clientes", new { id = Model.ClienteId })#tab-fiscal" class="btn btn-outline-secondary">
                    <i class="ti ti-arrow-left me-1"></i>Volver
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">

        <!-- Filtros -->
        <div class="card mb-3">
            <div class="card-body">
                <form method="get" asp-action="Index" class="row g-3 align-items-end">
                    <input type="hidden" name="clienteId" value="@Model.ClienteId" />
                    <div class="col-md-4">
                        <label class="form-label">Mes</label>
                        <select name="mes" class="form-select">
                            @for (int i = 1; i <= 12; i++)
                            {
                                if (Model.Mes == i)
                                {
                                    <option value="@i" selected>@meses[i - 1]</option>
                                }
                                else
                                {
                                    <option value="@i">@meses[i - 1]</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Año</label>
                        <select name="anio" class="form-select">
                            @for (int y = anioActual; y >= anioActual - 5; y--)
                            {
                                if (Model.Anio == y)
                                {
                                    <option value="@y" selected>@y</option>
                                }
                                else
                                {
                                    <option value="@y">@y</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4 d-flex gap-2">
                        <button type="submit" class="btn sg-btn-primary-dark flex-fill">
                            <i class="ti ti-calculator me-1"></i>Calcular
                        </button>
                        <a asp-action="Index" asp-route-clienteId="@Model.ClienteId" class="btn btn-outline-secondary">
                            <i class="ti ti-x"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.Resultado is null)
        {
            <div class="card">
                <div class="card-body">
                    <div class="empty">
                        <div class="empty-img">
                            <i class="ti ti-cash fs-1 text-secondary"></i>
                        </div>
                        <p class="empty-title">Seleccione el período</p>
                        <p class="empty-subtitle text-secondary">Elija el mes y año para calcular la liquidación de IVA.</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            var r = Model.Resultado;
            var esPagar = r.TipoSaldo == "APagar";
            var nombreMes = meses[r.Mes - 1];

            <!-- Tarjetas de resumen -->
            <div class="row g-3 mb-3">
                <div class="col-12 col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="text-secondary">IVA Ventas (Débito Fiscal)</div>
                            <div class="display-6 fw-semibold text-blue">
                                $ @r.TotalIvaVentas.ToString("N2")
                            </div>
                            <div class="text-muted small mt-1">Lo que la empresa cobró a clientes</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="text-secondary">IVA Compras (Crédito Fiscal)</div>
                            <div class="display-6 fw-semibold text-cyan">
                                $ @r.TotalIvaCompras.ToString("N2")
                            </div>
                            <div class="text-muted small mt-1">Lo que la empresa pagó a proveedores</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card @(esPagar ? "border-danger" : "border-success")">
                        <div class="card-status-start @(esPagar ? "bg-danger" : "bg-success")"></div>
                        <div class="card-body">
                            <div class="text-secondary">Saldo del período</div>
                            <div class="display-6 fw-semibold @(esPagar ? "text-danger" : "text-success")">
                                $ @r.SaldoNeto.ToString("N2")
                            </div>
                            <div class="mt-1">
                                @if (esPagar)
                                {
                                    <span class="badge bg-danger-lt text-danger">
                                        <i class="ti ti-arrow-up"></i> A pagar a DGI
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-lt text-success">
                                        <i class="ti ti-arrow-down"></i> Crédito fiscal a favor
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabla detalle del cálculo -->
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        Detalle — @nombreMes @r.Anio
                    </h3>
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Concepto</th>
                                <th class="text-end">Importe (UYU)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>IVA Ventas (Débito Fiscal)</td>
                                <td class="text-end">$ @r.TotalIvaVentas.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td>IVA Compras (Crédito Fiscal)</td>
                                <td class="text-end text-danger">- $ @r.TotalIvaCompras.ToString("N2")</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td>
                                    @if (esPagar)
                                    {
                                        <span>IVA a pagar a DGI</span>
                                    }
                                    else
                                    {
                                        <span>Crédito fiscal a favor</span>
                                    }
                                </td>
                                <td class="text-end @(esPagar ? "text-danger" : "text-success")">
                                    $ @r.SaldoNeto.ToString("N2")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@model CierreEjercicioPageViewModel
@{
    ViewData["Title"] = "Cierre de Ejercicio";
    ViewData["ClienteId"] = Model.ClienteId;
    ViewData["ClienteNombre"] = Model.ClienteNombre;

    var ejerciciosAbiertos  = Model.Ejercicios.Where(e => e.Estado == "Abierto").ToList();
    var ejerciciosCerrados  = Model.Ejercicios.Where(e => e.Estado == "Cerrado").ToList();
    var seleccionado        = Model.EjercicioSeleccionadoId.HasValue
                                ? Model.Ejercicios.FirstOrDefault(e => e.Id == Model.EjercicioSeleccionadoId)
                                : ejerciciosAbiertos.FirstOrDefault();
    var resultado           = Model.ResultadoCierre;
    var hayResultado        = resultado is not null;
    var esGanancia          = hayResultado && resultado!.ResultadoNeto >= 0;
}

<!-- ── Encabezado ─────────────────────────────────────────────────── -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div style="font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#6c7a8d;font-weight:600;margin-bottom:2px;">
            Cliente
        </div>
        <h2 class="fw-bold mb-1" style="font-size:1.6rem;color:#1a3a5c;">
            <i class="ti ti-calendar-x me-2"></i>Cierre de Ejercicio
        </h2>
        <div class="text-muted" style="font-size:.92rem;">@Model.ClienteNombre</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" asp-controller="Ejercicios" asp-route-clienteId="@Model.ClienteId"
           class="btn btn-outline-secondary">
            <i class="ti ti-calendar me-1"></i>Ver ejercicios
        </a>
        <a asp-action="Detalles" asp-controller="Clientes" asp-route-id="@Model.ClienteId"
           class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>Volver al cliente
        </a>
    </div>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible mb-4" role="alert">
        <i class="ti ti-alert-circle me-2"></i>@error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success alert-dismissible mb-4" role="alert">
        <i class="ti ti-circle-check me-2"></i>@exito
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">

    <!-- ── Columna izquierda: Ejercicios ─────────────────────────── -->
    <div class="col-12 col-lg-5">

        <!-- Ejercicios abiertos -->
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title mb-0">
                    <i class="ti ti-calendar-stats me-2 text-success"></i>Ejercicios abiertos
                </h3>
            </div>
            <div class="card-body p-2">
                @if (ejerciciosAbiertos.Count == 0)
                {
                    <div class="empty py-4">
                        <div class="empty-img"><i class="ti ti-calendar-off fs-2 text-secondary"></i></div>
                        <p class="empty-title">Sin ejercicios abiertos</p>
                        <p class="empty-subtitle text-muted">No hay ejercicios disponibles para cerrar.</p>
                        <a asp-action="Crear" asp-controller="Ejercicios" asp-route-clienteId="@Model.ClienteId"
                           class="btn btn-sm btn-azure mt-2">
                            <i class="ti ti-plus me-1"></i>Crear ejercicio
                        </a>
                    </div>
                }
                else
                {
                    foreach (var ej in ejerciciosAbiertos)
                    {
                        var esSeleccionado = seleccionado?.Id == ej.Id;
                        <a asp-action="CierreEjercicio"
                           asp-route-clienteId="@Model.ClienteId"
                           asp-route-ejercicioId="@ej.Id"
                           class="d-block rounded p-3 mb-1 text-decoration-none
                                  @(esSeleccionado ? "bg-azure-lt border border-azure" : "bg-light border border-transparent")
                                  @("hover-bg-azure-lt")"
                           style="transition:background .15s;">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-semibold" style="color:#1a3a5c;">
                                        @ej.FechaInicio.ToString("dd/MM/yyyy")
                                        <span class="text-muted mx-1">→</span>
                                        @ej.FechaFin.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="mt-1">
                                        <span class="badge bg-green-lt text-green">Abierto</span>
                                    </div>
                                </div>
                                @if (esSeleccionado)
                                {
                                    <i class="ti ti-chevron-right text-azure fs-5"></i>
                                }
                            </div>
                        </a>
                    }
                }
            </div>
        </div>

        <!-- Ejercicios cerrados (colapsable) -->
        @if (ejerciciosCerrados.Count > 0)
        {
            <div class="card">
                <div class="card-header" style="cursor:pointer;" data-bs-toggle="collapse" data-bs-target="#ejercicios-cerrados">
                    <h3 class="card-title mb-0 d-flex align-items-center justify-content-between w-100">
                        <span><i class="ti ti-lock me-2 text-muted"></i>Ejercicios cerrados</span>
                        <span class="badge bg-secondary-lt">@ejerciciosCerrados.Count</span>
                    </h3>
                </div>
                <div class="collapse" id="ejercicios-cerrados">
                    <div class="card-body p-2">
                        @foreach (var ej in ejerciciosCerrados)
                        {
                            <div class="d-flex align-items-center justify-content-between p-3 rounded border mb-1 bg-light">
                                <div>
                                    <div class="fw-semibold text-muted" style="font-size:.9rem;">
                                        @ej.FechaInicio.ToString("dd/MM/yyyy")
                                        <span class="mx-1">→</span>
                                        @ej.FechaFin.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="mt-1">
                                        <span class="badge bg-secondary-lt text-secondary">Cerrado</span>
                                    </div>
                                </div>
                                <i class="ti ti-lock text-muted"></i>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- ── Columna derecha: Panel de cierre / resultado ──────────── -->
    <div class="col-12 col-lg-7">

        @if (hayResultado && resultado is not null)
        {
            <!-- ── Zona C: Resultado del cierre ────────────────── -->
            <div class="card mb-4 border-0 shadow-sm">
                <div class="card-header @(esGanancia ? "bg-success-lt" : "bg-danger-lt") border-0">
                    <h3 class="card-title mb-0">
                        <i class="ti @(esGanancia ? "ti-trending-up text-success" : "ti-trending-down text-danger") me-2"></i>
                        Cierre ejecutado — @(esGanancia ? "Ganancia del período" : "Pérdida del período")
                    </h3>
                </div>
                <div class="card-body">

                    <!-- KPIs -->
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="card bg-green-lt border-0 text-center p-3">
                                <div style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;">Ingresos</div>
                                <div class="fw-bold fs-4 text-success mt-1">@resultado.TotalIngresos.ToString("N2")</div>
                                <div class="text-muted" style="font-size:.75rem;">UYU</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card bg-red-lt border-0 text-center p-3">
                                <div style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;">Egresos</div>
                                <div class="fw-bold fs-4 text-danger mt-1">@resultado.TotalEgresos.ToString("N2")</div>
                                <div class="text-muted" style="font-size:.75rem;">UYU</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card @(esGanancia ? "bg-green-lt" : "bg-red-lt") border-0 text-center p-3">
                                <div style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;">Resultado Neto</div>
                                <div class="fw-bold fs-4 @(esGanancia ? "text-success" : "text-danger") mt-1">
                                    @Math.Abs(resultado.ResultadoNeto).ToString("N2")
                                </div>
                                <div class="text-muted" style="font-size:.75rem;">UYU</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card bg-azure-lt border-0 text-center p-3">
                                <div style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;">Asientos</div>
                                <div class="fw-bold fs-4 text-azure mt-1">@resultado.AsientosGenerados</div>
                                <div class="text-muted" style="font-size:.75rem;">generados</div>
                            </div>
                        </div>
                    </div>

                    <!-- Acceso a reportes -->
                    <h4 class="mb-3" style="font-size:.95rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;">
                        Estados financieros del período cerrado
                    </h4>
                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <a asp-action="Index" asp-controller="EstadoResultados"
                               asp-route-clienteId="@Model.ClienteId"
                               asp-route-fechaDesde="@seleccionado!.FechaInicio.ToString("yyyy-MM-dd")"
                               asp-route-fechaHasta="@seleccionado!.FechaFin.ToString("yyyy-MM-dd")"
                               class="btn btn-outline-secondary w-100 text-start d-flex align-items-center gap-2">
                                <i class="ti ti-chart-bar fs-5"></i>
                                <span>Estado de Resultados</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-action="Index" asp-controller="BalanceGeneral"
                               asp-route-clienteId="@Model.ClienteId"
                               asp-route-fechaHasta="@seleccionado!.FechaFin.ToString("yyyy-MM-dd")"
                               class="btn btn-outline-secondary w-100 text-start d-flex align-items-center gap-2">
                                <i class="ti ti-scale fs-5"></i>
                                <span>Balance General</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-action="Index" asp-controller="AsientosContables"
                               asp-route-clienteId="@Model.ClienteId"
                               asp-route-ejercicioId="@seleccionado!.Id"
                               class="btn btn-outline-secondary w-100 text-start d-flex align-items-center gap-2">
                                <i class="ti ti-book fs-5"></i>
                                <span>Libro Diario</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-action="Index" asp-controller="LibroMayor"
                               asp-route-clienteId="@Model.ClienteId"
                               asp-route-ejercicioId="@seleccionado!.Id"
                               asp-route-fechaDesde="@seleccionado!.FechaInicio.ToString("yyyy-MM-dd")"
                               asp-route-fechaHasta="@seleccionado!.FechaFin.ToString("yyyy-MM-dd")"
                               class="btn btn-outline-secondary w-100 text-start d-flex align-items-center gap-2">
                                <i class="ti ti-books fs-5"></i>
                                <span>Libro Mayor</span>
                            </a>
                        </div>
                    </div>

                    <!-- Asientos de cierre + nuevo ejercicio -->
                    <div class="d-flex flex-wrap gap-2 mb-0">
                        <a asp-action="ReporteCierre" asp-controller="Ejercicios"
                           asp-route-clienteId="@Model.ClienteId"
                           asp-route-ejercicioId="@seleccionado!.Id"
                           class="btn btn-outline-azure">
                            <i class="ti ti-file-text me-1"></i>Ver asientos de cierre
                        </a>
                        <a asp-action="Crear" asp-controller="Ejercicios" asp-route-clienteId="@Model.ClienteId"
                           class="btn btn-azure">
                            <i class="ti ti-plus me-1"></i>Nuevo ejercicio
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (seleccionado is not null && seleccionado.Estado == "Abierto")
        {
            <!-- ── Zona B: Panel de confirmación ────────────────── -->
            <div class="card border-0 shadow-sm">
                <div class="card-header border-0" style="background:#1a3a5c;">
                    <h3 class="card-title mb-0 text-white">
                        <i class="ti ti-calendar-x me-2"></i>
                        Cerrar:
                        @seleccionado.FechaInicio.ToString("dd/MM/yyyy") → @seleccionado.FechaFin.ToString("dd/MM/yyyy")
                    </h3>
                </div>
                <div class="card-body">

                    <!-- Checklist de pasos -->
                    <h4 class="mb-3" style="font-size:.95rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;">
                        El proceso ejecutará automáticamente
                    </h4>
                    <div class="list-group list-group-flush mb-4">
                        <div class="list-group-item d-flex align-items-start gap-3 px-0 border-0 pb-3">
                            <span class="badge bg-azure-lt text-azure rounded-circle p-2 flex-shrink-0" style="width:32px;height:32px;display:flex;align-items:center;justify-content:center;">1</span>
                            <div>
                                <div class="fw-semibold">Cierre de cuentas de ingresos</div>
                                <div class="text-muted" style="font-size:.85rem;">
                                    Se genera un asiento debitando todas las cuentas de ingresos con saldo y acreditando "Resumen de resultados".
                                </div>
                            </div>
                        </div>
                        <div class="list-group-item d-flex align-items-start gap-3 px-0 border-0 pb-3">
                            <span class="badge bg-azure-lt text-azure rounded-circle p-2 flex-shrink-0" style="width:32px;height:32px;display:flex;align-items:center;justify-content:center;">2</span>
                            <div>
                                <div class="fw-semibold">Cierre de cuentas de egresos</div>
                                <div class="text-muted" style="font-size:.85rem;">
                                    Se genera un asiento acreditando todas las cuentas de egresos con saldo y debitando "Resumen de resultados".
                                </div>
                            </div>
                        </div>
                        <div class="list-group-item d-flex align-items-start gap-3 px-0 border-0 pb-3">
                            <span class="badge bg-azure-lt text-azure rounded-circle p-2 flex-shrink-0" style="width:32px;height:32px;display:flex;align-items:center;justify-content:center;">3</span>
                            <div>
                                <div class="fw-semibold">Transferencia al patrimonio</div>
                                <div class="text-muted" style="font-size:.85rem;">
                                    El saldo neto de "Resumen de resultados" se transfiere a "Resultado del ejercicio" en el patrimonio.
                                </div>
                            </div>
                        </div>
                        <div class="list-group-item d-flex align-items-start gap-3 px-0 border-0">
                            <span class="badge bg-red-lt text-danger rounded-circle p-2 flex-shrink-0" style="width:32px;height:32px;display:flex;align-items:center;justify-content:center;">
                                <i class="ti ti-lock" style="font-size:.8rem;"></i>
                            </span>
                            <div>
                                <div class="fw-semibold">Bloqueo del período</div>
                                <div class="text-muted" style="font-size:.85rem;">
                                    El ejercicio pasa a estado <strong>Cerrado</strong>. No se podrán registrar nuevos asientos en este período.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
                        <i class="ti ti-alert-triangle flex-shrink-0"></i>
                        <div>Esta acción es <strong>irreversible</strong>. Una vez cerrado el ejercicio, el período quedará bloqueado.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modal-confirmar-cierre">
                            <i class="ti ti-calendar-x me-1"></i>Ejecutar cierre
                        </button>
                        <a asp-action="Detalles" asp-controller="Clientes" asp-route-id="@Model.ClienteId"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>
                    </div>
                </div>
            </div>
        }
        else if (seleccionado is null && ejerciciosAbiertos.Count == 0 && !hayResultado)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="empty py-5">
                        <div class="empty-img"><i class="ti ti-calendar-off fs-1 text-secondary"></i></div>
                        <p class="empty-title">Sin ejercicios disponibles</p>
                        <p class="empty-subtitle text-muted">No hay ejercicios abiertos para este cliente. Creá uno para comenzar.</p>
                        <a asp-action="Crear" asp-controller="Ejercicios" asp-route-clienteId="@Model.ClienteId"
                           class="btn btn-azure mt-2">
                            <i class="ti ti-plus me-1"></i>Crear ejercicio
                        </a>
                    </div>
                </div>
            </div>
        }
        else if (seleccionado is not null && seleccionado.Estado == "Cerrado" && !hayResultado)
        {
            <!-- ── Zona D: Reportes de ejercicio cerrado ────────── -->
            <div class="card border-0 shadow-sm">
                <div class="card-header border-0" style="background:#1a3a5c;">
                    <h3 class="card-title mb-0 text-white">
                        <i class="ti ti-lock me-2"></i>
                        Ejercicio cerrado:
                        @seleccionado.FechaInicio.ToString("dd/MM/yyyy") → @seleccionado.FechaFin.ToString("dd/MM/yyyy")
                    </h3>
                </div>
                <div class="card-body">

                    <div class="alert alert-secondary d-flex align-items-center gap-2 mb-4">
                        <i class="ti ti-info-circle flex-shrink-0"></i>
                        <div>Este período está <strong>bloqueado</strong>. Podés consultar todos sus estados financieros y reportes a continuación.</div>
                    </div>

                    <!-- KPIs rápidos de fechas -->
                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <div class="card bg-light border-0 text-center p-3">
                                <div style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;">Inicio del período</div>
                                <div class="fw-bold text-azure mt-1">@seleccionado.FechaInicio.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card bg-light border-0 text-center p-3">
                                <div style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;">Fin del período</div>
                                <div class="fw-bold text-azure mt-1">@seleccionado.FechaFin.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>
                    </div>

                    <h4 class="mb-3" style="font-size:.95rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;">
                        Estados financieros
                    </h4>
                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <a asp-action="Index" asp-controller="EstadoResultados"
                               asp-route-clienteId="@Model.ClienteId"
                               asp-route-fechaDesde="@seleccionado.FechaInicio.ToString("yyyy-MM-dd")"
                               asp-route-fechaHasta="@seleccionado.FechaFin.ToString("yyyy-MM-dd")"
                               class="btn btn-outline-secondary w-100 text-start d-flex align-items-center gap-2 py-3">
                                <i class="ti ti-chart-bar fs-4 text-azure"></i>
                                <div>
                                    <div class="fw-semibold">Estado de Resultados</div>
                                    <div class="text-muted" style="font-size:.78rem;">Ingresos y egresos del período</div>
                                </div>
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-action="Index" asp-controller="BalanceGeneral"
                               asp-route-clienteId="@Model.ClienteId"
                               asp-route-fechaHasta="@seleccionado.FechaFin.ToString("yyyy-MM-dd")"
                               class="btn btn-outline-secondary w-100 text-start d-flex align-items-center gap-2 py-3">
                                <i class="ti ti-scale fs-4 text-azure"></i>
                                <div>
                                    <div class="fw-semibold">Balance General</div>
                                    <div class="text-muted" style="font-size:.78rem;">Activos, pasivos y patrimonio</div>
                                </div>
                            </a>
                        </div>
                    </div>

                    <h4 class="mb-3" style="font-size:.95rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;">
                        Libros contables
                    </h4>
                    <div class="row g-2">
                        <div class="col-6">
                            <a asp-action="Index" asp-controller="AsientosContables"
                               asp-route-clienteId="@Model.ClienteId"
                               asp-route-ejercicioId="@seleccionado.Id"
                               class="btn btn-outline-secondary w-100 text-start d-flex align-items-center gap-2 py-3">
                                <i class="ti ti-book fs-4 text-azure"></i>
                                <div>
                                    <div class="fw-semibold">Libro Diario</div>
                                    <div class="text-muted" style="font-size:.78rem;">Todos los asientos del período</div>
                                </div>
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-action="Index" asp-controller="LibroMayor"
                               asp-route-clienteId="@Model.ClienteId"
                               asp-route-ejercicioId="@seleccionado.Id"
                               asp-route-fechaDesde="@seleccionado.FechaInicio.ToString("yyyy-MM-dd")"
                               asp-route-fechaHasta="@seleccionado.FechaFin.ToString("yyyy-MM-dd")"
                               class="btn btn-outline-secondary w-100 text-start d-flex align-items-center gap-2 py-3">
                                <i class="ti ti-books fs-4 text-azure"></i>
                                <div>
                                    <div class="fw-semibold">Libro Mayor</div>
                                    <div class="text-muted" style="font-size:.78rem;">Movimientos por cuenta</div>
                                </div>
                            </a>
                        </div>
                    </div>

                    <div class="mt-3 pt-3 border-top">
                        <a asp-action="ReporteCierre" asp-controller="Ejercicios"
                           asp-route-clienteId="@Model.ClienteId"
                           asp-route-ejercicioId="@seleccionado.Id"
                           class="btn btn-outline-azure w-100">
                            <i class="ti ti-file-text me-1"></i>Ver asientos de cierre del período
                        </a>
                    </div>
                </div>
            </div>
        }

    </div>
</div>

@if (seleccionado is not null && seleccionado.Estado == "Abierto")
{
    @section Scripts {
        <div class="modal fade" id="modal-confirmar-cierre" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header" style="background:#1a3a5c;">
                        <h5 class="modal-title text-white">
                            <i class="ti ti-calendar-x me-2"></i>Confirmar cierre de ejercicio
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-2">Vas a cerrar el ejercicio:</p>
                        <div class="bg-light rounded p-3 mb-3 fw-semibold text-center" style="color:#1a3a5c;font-size:1.05rem;">
                            @seleccionado.FechaInicio.ToString("dd/MM/yyyy")
                            <span class="text-muted mx-2">→</span>
                            @seleccionado.FechaFin.ToString("dd/MM/yyyy")
                        </div>
                        <ul class="list-unstyled mb-0" style="font-size:.9rem;">
                            <li class="mb-1"><i class="ti ti-check text-success me-2"></i>Se generarán los asientos de cierre automáticamente</li>
                            <li class="mb-1"><i class="ti ti-check text-success me-2"></i>Se transferirá el resultado al patrimonio</li>
                            <li><i class="ti ti-alert-triangle text-warning me-2"></i>El período quedará <strong>bloqueado e irreversible</strong></li>
                        </ul>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <form asp-action="Cerrar"
                              asp-route-id="@seleccionado.Id"
                              asp-route-clienteId="@Model.ClienteId"
                              method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">
                                <i class="ti ti-calendar-x me-1"></i>Confirmar cierre
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}

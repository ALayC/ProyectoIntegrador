@model ReporteCierreViewModel
@{
    ViewData["Title"] = "Asientos de Cierre";
    ViewData["ClienteId"] = Model.ClienteId;
    ViewData["ClienteNombre"] = Model.ClienteNombre;
}

<!-- ── Encabezado ─────────────────────────────────────────────────── -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div style="font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#6c7a8d;font-weight:600;margin-bottom:2px;">
            Cliente
        </div>
        <h2 class="fw-bold mb-1" style="font-size:1.6rem;color:#1a3a5c;">
            <i class="ti ti-file-text me-2"></i>Asientos de Cierre
        </h2>
        <div class="text-muted" style="font-size:.92rem;">
            @Model.ClienteNombre
            <span class="mx-2">·</span>
            @Model.Ejercicio.FechaInicio.ToString("dd/MM/yyyy") → @Model.Ejercicio.FechaFin.ToString("dd/MM/yyyy")
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="CierreEjercicio" asp-controller="Ejercicios"
           asp-route-clienteId="@Model.ClienteId"
           asp-route-ejercicioId="@Model.Ejercicio.Id"
           class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>Volver al cierre
        </a>
    </div>
</div>

@if (Model.Asientos.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="empty py-5">
                <div class="empty-img"><i class="ti ti-file-off fs-1 text-secondary"></i></div>
                <p class="empty-title">Sin asientos de cierre</p>
                <p class="empty-subtitle text-muted">Este ejercicio no tiene asientos de cierre registrados.</p>
            </div>
        </div>
    </div>
}
else
{
    <!-- Resumen rápido -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card bg-azure-lt border-0 text-center p-3">
                <div style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;">Asientos generados</div>
                <div class="fw-bold fs-3 text-azure mt-1">@Model.Asientos.Count</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card bg-green-lt border-0 text-center p-3">
                <div style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;">Total Debe</div>
                <div class="fw-bold fs-3 text-success mt-1">@Model.Asientos.Sum(a => a.TotalDebe).ToString("N2")</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card bg-red-lt border-0 text-center p-3">
                <div style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;">Total Haber</div>
                <div class="fw-bold fs-3 text-danger mt-1">@Model.Asientos.Sum(a => a.TotalHaber).ToString("N2")</div>
            </div>
        </div>
    </div>

    <!-- Un card por cada asiento de cierre -->
    @foreach (var asiento in Model.Asientos)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header border-0" style="background:#1a3a5c;">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h3 class="card-title mb-0 text-white">
                        <i class="ti ti-receipt me-2"></i>
                        Asiento N° @asiento.Numero — @asiento.Glosa
                    </h3>
                    <span class="badge bg-white text-dark" style="font-size:.8rem;">
                        @asiento.Fecha.ToString("dd/MM/yyyy")
                    </span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-vcenter table-hover mb-0">
                        <thead>
                            <tr style="background:#f0f4f8;">
                                <th style="font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;padding-left:1rem;">Código</th>
                                <th style="font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;">Cuenta</th>
                                <th class="text-end" style="font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;">Debe</th>
                                <th class="text-end" style="font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;color:#6c7a8d;padding-right:1rem;">Haber</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var linea in asiento.Lineas)
                            {
                                <tr>
                                    <td class="text-muted ps-3" style="font-size:.88rem;font-family:monospace;">@linea.CodigoCuenta</td>
                                    <td style="font-size:.9rem;">@linea.NombreCuenta</td>
                                    <td class="text-end" style="font-size:.9rem;">
                                        @if (linea.Debe > 0)
                                        {
                                            <span class="text-success fw-semibold">@linea.Debe.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3" style="font-size:.9rem;">
                                        @if (linea.Haber > 0)
                                        {
                                            <span class="text-danger fw-semibold">@linea.Haber.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="background:#f8fafc;border-top:2px solid #e0e7ef;">
                                <td colspan="2" class="fw-bold ps-3" style="font-size:.88rem;text-transform:uppercase;letter-spacing:.04em;color:#6c7a8d;">Totales</td>
                                <td class="text-end fw-bold text-success" style="font-size:.95rem;">@asiento.TotalDebe.ToString("N2")</td>
                                <td class="text-end fw-bold text-danger pe-3" style="font-size:.95rem;">@asiento.TotalHaber.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
}

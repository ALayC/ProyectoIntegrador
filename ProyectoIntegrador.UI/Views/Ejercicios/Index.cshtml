@model EjercicioContableIndexViewModel
@{
    ViewData["Title"] = "Ejercicios contables";
    ViewData["ClienteId"] = Model.ClienteId;
    ViewData["ClienteNombre"] = Model.ClienteNombre;
    var paginado = Model.Paginado;
    var ejercicios = paginado.Datos;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-1"><i class="ti ti-calendar"></i> Ejercicios contables</h2>
        @if (!string.IsNullOrWhiteSpace(Model.ClienteNombre))
        {
            <div class="text-secondary">@Model.ClienteNombre</div>
        }
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Crear" asp-route-clienteId="@Model.ClienteId" class="btn btn-azure">
            <i class="ti ti-plus"></i> Nuevo ejercicio
        </a>
        <a asp-controller="AsientosContables" asp-action="Crear" asp-route-clienteId="@Model.ClienteId" class="btn btn-outline-azure">
            <i class="ti ti-notes"></i> Nuevo asiento
        </a>
        <a asp-controller="Clientes" asp-action="Detalles" asp-route-id="@Model.ClienteId" class="btn btn-outline-azure">
            <i class="ti ti-arrow-left"></i> Volver
        </a>
    </div>
</div>

@if (ejercicios.Count == 0)
{
    <div class="card">
        <div class="card-body">
            <div class="empty">
                <div class="empty-img">
                    <i class="ti ti-calendar-off fs-1 text-secondary"></i>
                </div>
                <p class="empty-title">No hay ejercicios contables</p>
                <p class="empty-subtitle text-secondary">Todavía no se registraron ejercicios para este cliente.</p>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Período</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ejercicio in ejercicios)
                        {
                            var esAbierto = ejercicio.Estado == "Abierto";
                            <tr class="@(esAbierto ? string.Empty : "text-muted")">
                                <td>
                                    @ejercicio.FechaInicio.ToString("dd/MM/yyyy")
                                    <span class="text-secondary">–</span>
                                    @ejercicio.FechaFin.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    @if (esAbierto)
                                    {
                                        <span class="badge bg-green-lt text-green">Abierto</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-muted-lt text-muted">Cerrado</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (esAbierto)
                                    {
                                        <a asp-action="Editar" asp-route-id="@ejercicio.Id" asp-route-clienteId="@Model.ClienteId"
                                           class="btn btn-sm btn-outline-azure" title="Editar">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-azure" disabled aria-disabled="true">
                                            <i class="ti ti-edit"></i>
                                        </button>
                                    }
                                    @if (esAbierto)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cerrar-@ejercicio.Id">
                                            <i class="ti ti-lock"></i>
                                        </button>

                                        <div class="modal modal-blur fade" id="cerrar-@ejercicio.Id" tabindex="-1" role="dialog" aria-hidden="true">
                                            <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Cerrar ejercicio</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                                    </div>
                                                    <div class="modal-body text-secondary">
                                                        Esta acción es irreversible. ¿Deseas cerrar el ejercicio?
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-outline-azure" data-bs-dismiss="modal">Cancelar</button>
                                                        <form asp-action="Cerrar" asp-route-id="@ejercicio.Id" asp-route-clienteId="@Model.ClienteId" method="post">
                                                            <button type="submit" class="btn btn-danger">Cerrar</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                            <i class="ti ti-lock"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (paginado.TotalPaginas > 1)
    {
        <nav aria-label="Paginación de ejercicios" class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(!paginado.TienePaginaAnterior ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-clienteId="@Model.ClienteId"
                       asp-route-pagina="@(paginado.Pagina - 1)"
                       asp-route-cantidadPorPagina="@paginado.CantidadPorPagina">&laquo; Anterior</a>
                </li>
                @for (int i = 1; i <= paginado.TotalPaginas; i++)
                {
                    <li class="page-item @(i == paginado.Pagina ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-clienteId="@Model.ClienteId"
                           asp-route-pagina="@i"
                           asp-route-cantidadPorPagina="@paginado.CantidadPorPagina">@i</a>
                    </li>
                }
                <li class="page-item @(!paginado.TienePaginaSiguiente ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-clienteId="@Model.ClienteId"
                       asp-route-pagina="@(paginado.Pagina + 1)"
                       asp-route-cantidadPorPagina="@paginado.CantidadPorPagina">Siguiente &raquo;</a>
                </li>
            </ul>
        </nav>
    }
}

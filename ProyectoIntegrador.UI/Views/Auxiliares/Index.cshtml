@model AuxiliarViewModel
@{
    ViewData["Title"] = "Mis Auxiliares Contables";
}

<div class="d-flex justify-content-between align-items-center mb-3" data-aos="fade-down">
    <div>
        <h2 class="mb-1"><i class="ti ti-users-group"></i> Auxiliares Contables</h2>
        <div class="text-secondary">Gestioná las invitaciones y accesos de tus auxiliares.</div>
    </div>
    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left"></i> Volver
    </a>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="ti ti-circle-check me-1"></i> @ok
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="ti ti-alert-circle me-1"></i> @err
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">

    @* ── Invitar ──────────────────────────────────────────────────────────── *@
    <div class="col-lg-4" data-aos="fade-up">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-mail me-1"></i> Invitar auxiliar</h3>
            </div>
            <div class="card-body">
                <p class="text-secondary small">
                    Ingresá el email de la persona a invitar. Recibirá un correo con un link para registrarse.
                    La invitación expira en <strong>7 días</strong>.
                </p>
                <form asp-action="Invitar" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="FormInvitar.Email" class="form-label">Email</label>
                        <input asp-for="FormInvitar.Email" class="form-control" type="email"
                               placeholder="auxiliar@ejemplo.com" autocomplete="off" />
                        <span asp-validation-for="FormInvitar.Email" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-azure w-100">
                        <i class="ti ti-send me-1"></i> Enviar invitación
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">

        @* ── Invitaciones pendientes ──────────────────────────────────────── *@
        <div class="card mb-3" data-aos="fade-up" data-aos-delay="50">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-mail-forward me-1"></i> Invitaciones enviadas</h3>
            </div>
            @if (Model.Invitaciones.Count == 0)
            {
                <div class="card-body">
                    <div class="empty">
                        <div class="empty-img"><i class="ti ti-mail-off fs-1 text-secondary"></i></div>
                        <p class="empty-title">Sin invitaciones</p>
                        <p class="empty-subtitle text-secondary">Todavía no invitaste a ningún auxiliar.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Email</th>
                                <th class="text-center">Estado</th>
                                <th class="text-end">Expira</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in Model.Invitaciones)
                            {
                                var estadoBadge = inv.Estado switch
                                {
                                    "Pendiente"  => "bg-warning-lt text-warning",
                                    "Aceptada"   => "bg-success-lt text-success",
                                    "Revocada"   => "bg-secondary-lt text-secondary",
                                    _            => "bg-secondary-lt text-secondary"
                                };
                                var expirada = inv.Estado == "Pendiente" && inv.FechaExpiracion < DateTime.UtcNow;
                                <tr class="@(expirada ? "table-warning opacity-75" : "")">
                                    <td>@inv.Email</td>
                                    <td class="text-center">
                                        <span class="badge @estadoBadge">
                                            @(expirada ? "Expirada" : inv.Estado)
                                        </span>
                                    </td>
                                    <td class="text-end text-secondary small">
                                        @inv.FechaExpiracion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* ── Auxiliares activos/inactivos ───────────────────────────────── *@
        <div class="card" data-aos="fade-up" data-aos-delay="100">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-users me-1"></i> Auxiliares</h3>
            </div>
            @if (Model.Auxiliares.Count == 0)
            {
                <div class="card-body">
                    <div class="empty">
                        <div class="empty-img"><i class="ti ti-user-off fs-1 text-secondary"></i></div>
                        <p class="empty-title">Sin auxiliares</p>
                        <p class="empty-subtitle text-secondary">Todavía ningún auxiliar aceptó tu invitación.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th class="text-center">Estado</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var aux in Model.Auxiliares)
                            {
                                var estadoBadge = aux.Estado == "Activo"
                                    ? "bg-success-lt text-success"
                                    : "bg-secondary-lt text-secondary";

                                <tr>
                                    <td class="fw-semibold">@aux.NombreCompleto</td>
                                    <td class="text-secondary">@aux.Email</td>
                                    <td class="text-center">
                                        <span class="badge @estadoBadge">@aux.Estado</span>
                                    </td>
                                    <td class="text-end">
                                        @if (aux.Estado == "Activo")
                                        {
                                            <form asp-action="Revocar" asp-route-id="@aux.Id" method="post"
                                                  onsubmit="return confirm('¿Revocar acceso de @aux.NombreCompleto? El usuario quedará inactivo.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="ti ti-user-x me-1"></i> Revocar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-secondary small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
</div>

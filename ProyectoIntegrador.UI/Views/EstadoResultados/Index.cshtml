@model EstadoResultadosViewModel
@{
    ViewData["Title"] = "Estado de Resultados";
    ViewData["ClienteId"] = Model.ClienteId;
    ViewData["ClienteNombre"] = Model.ClienteNombre;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3" data-aos="fade-down">
    <div>
        <h2 class="mb-1"><i class="ti ti-chart-line"></i> Estado de Resultados</h2>
        @if (!string.IsNullOrWhiteSpace(Model.ClienteNombre))
        {
            <div class="text-secondary">@Model.ClienteNombre</div>
        }
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Clientes" asp-action="Detalles" asp-route-id="@Model.ClienteId" class="btn btn-outline-azure">
            <i class="ti ti-arrow-left"></i> Volver
        </a>
        @if (Model.Resultado is not null)
        {
            <a asp-action="ExportarExcel"
               asp-route-clienteId="@Model.ClienteId"
               asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
               asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))"
               class="btn btn-outline-success">
                <i class="ti ti-file-spreadsheet"></i> Exportar Excel
            </a>
            <a asp-action="ExportarPdf"
               asp-route-clienteId="@Model.ClienteId"
               asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
               asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))"
               class="btn btn-outline-danger">
                <i class="ti ti-file-type-pdf"></i> Exportar PDF
            </a>
        }
    </div>
</div>

<div class="card mb-3" data-aos="fade-up">
    <div class="card-header">
        <h3 class="card-title"><i class="ti ti-filter me-1"></i> Filtros</h3>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <input type="hidden" name="clienteId" value="@Model.ClienteId" />
            <div class="col-md-4">
                <label class="form-label">Fecha desde</label>
                <input type="date" name="fechaDesde" class="form-control"
                       value="@(Model.FechaDesde.HasValue ? Model.FechaDesde.Value.ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Fecha hasta</label>
                <input type="date" name="fechaHasta" class="form-control"
                       value="@(Model.FechaHasta.HasValue ? Model.FechaHasta.Value.ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-4 d-flex gap-2 align-items-end">
                <button type="submit" class="btn btn-azure flex-fill">
                    <i class="ti ti-search"></i> Generar reporte
                </button>
                <a asp-action="Index" asp-route-clienteId="@Model.ClienteId" class="btn btn-outline-secondary">
                    <i class="ti ti-x"></i>
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.Resultado is null)
{
    <div class="card">
        <div class="card-body">
            <div class="empty">
                <div class="empty-img">
                    <i class="ti ti-chart-line fs-1 text-secondary"></i>
                </div>
                <p class="empty-title">Ingrese un rango de fechas</p>
                <p class="empty-subtitle text-secondary">Complete el formulario de filtros para generar el estado de resultados.</p>
            </div>
        </div>
    </div>
}
else
{
            <!-- Tarjetas de resumen -->
            <div class="row g-3 mb-3" data-aos="fade-up" data-aos-delay="60">
                <div class="col-12 col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="text-secondary">Total Ingresos</div>
                            <div class="display-6 fw-semibold text-success">
                                @Model.Resultado.TotalIngresos.ToString("N2")
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="text-secondary">Total Egresos</div>
                            <div class="display-6 fw-semibold text-danger">
                                @Model.Resultado.TotalEgresos.ToString("N2")
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="text-secondary">Resultado Neto</div>
                            <div class="display-6 fw-semibold @(Model.Resultado.ResultadoNeto >= 0 ? "text-success" : "text-danger")">
                                @Model.Resultado.ResultadoNeto.ToString("N2")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Árbol de Ingresos -->
            <div class="card mb-3">
                <div class="card-status-start bg-success"></div>
                <div class="card-header">
                    <h3 class="card-title">Ingresos</h3>
                </div>
                <div class="card-body p-0">
                    @if (Model.Resultado.Ingresos.Count == 0)
                    {
                        <div class="p-4">
                            <div class="empty">
                                <div class="empty-img">
                                    <i class="ti ti-folder-off fs-1 text-secondary"></i>
                                </div>
                                <p class="empty-title">No hay ingresos registrados</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var nodo in Model.Resultado.Ingresos)
                            {
                                @await Html.PartialAsync("_EstadoResultadoNodo", nodo, new ViewDataDictionary(ViewData) { ["Nivel"] = 0 })
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Árbol de Egresos -->
            <div class="card">
                <div class="card-status-start bg-danger"></div>
                <div class="card-header">
                    <h3 class="card-title">Egresos</h3>
                </div>
                <div class="card-body p-0">
                    @if (Model.Resultado.Egresos.Count == 0)
                    {
                        <div class="p-4">
                            <div class="empty">
                                <div class="empty-img">
                                    <i class="ti ti-folder-off fs-1 text-secondary"></i>
                                </div>
                                <p class="empty-title">No hay egresos registrados</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var nodo in Model.Resultado.Egresos)
                            {
                                @await Html.PartialAsync("_EstadoResultadoNodo", nodo, new ViewDataDictionary(ViewData) { ["Nivel"] = 0 })
                            }
                        </div>
                    }
                </div>
            </div>
        }
}
